const justPressed = {};
function checkJustPressed(code) {
  if(keys[code]&&!justPressed[code]) { justPressed[code]=true; return true; }
  if(!keys[code]) justPressed[code]=false;
  return false;
}

let tapFlag=false;
canvas.addEventListener('click', ()=>{ tapFlag=true; });
canvas.addEventListener('touchend', ()=>{ tapFlag=true; });

function handleMenuInput() {
  const up = checkJustPressed('KeyW')||checkJustPressed('ArrowUp');
  const dn = checkJustPressed('KeyS')||checkJustPressed('ArrowDown');
  const ok = checkJustPressed('Space')||checkJustPressed('Enter')||tapFlag;
  tapFlag=false;
  if(game.state===GS.MENU) {
    if(up) { game.menuSel=Math.max(0,game.menuSel-1); Audio.play('menu_move'); }
    if(dn) { game.menuSel=Math.min(2,game.menuSel+1); Audio.play('menu_move'); }
    if(ok) { game.diff=game.menuSel; game.state=GS.MODE; game.modeSel=0; Audio.play('menu_confirm'); }
  } else if(game.state===GS.MODE) {
    if(up) { game.modeSel=0; Audio.play('menu_move'); }
    if(dn) { game.modeSel=1; Audio.play('menu_move'); }
    if(ok) {
      game.mode=game.modeSel+1; game.level=1; initGame(); game.state=GS.PLAYING;
      document.getElementById('mobile-controls').style.display = game.isMobile||true?'block':'none';
      Audio.play('menu_confirm');
      Audio.playMusic(MUSIC_STAGE);
    }
  } else if(game.state===GS.GAMEOVER||game.state===GS.VICTORY) {
    if(ok) { game.state=GS.MENU; Audio.play('menu_confirm'); Audio.playMusic(MUSIC_MENU); }
  } else if(game.state===GS.PAUSED) {
    if(checkJustPressed('Escape')||ok) { game.state=GS.PLAYING; Audio.play('menu_confirm'); }
  } else if(game.state===GS.PLAYING) {
    if(checkJustPressed('Escape')) { game.state=GS.PAUSED; Audio.play('menu_move'); }
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: ENGINE — UPDATE
   ═══════════════════════════════════════════════════════════════════════════ */
function update() {
  handleMenuInput();
  if(game.state===GS.LEVEL_CLEAR) {
    game.levelClearTimer++;
    if(game.levelClearTimer>160) {
      game.level++;
      if(game.level>game.maxLevel) { game.state=GS.VICTORY; Audio.stopMusic(); Audio.play('powerup'); }
      else {
        game.enemies=[]; game.bullets=[]; game.powerups=[];
        game.boss=null; game.bossActive=false;
        game.waves=getLevelWaves(game.diff,game.level);
        game.currentWave=0; game.waveSpawnTimer=0;
        game.spawnedEnemies=[...game.waves[0]];
        game.state=GS.PLAYING;
        showFlash('LEVEL '+game.level);
        Audio.playMusic(MUSIC_STAGE);
        // Refill shield on novice between levels
        if(DIFF_CFG[game.diff].shield) game.players.forEach(p=>{ if(p.active){p.hasShield=true;p.shieldTime=600;} });
      }
    }
  }
  if(game.state!==GS.PLAYING) return;
  // Spawn enemies
  game.waveSpawnTimer++;
  if(game.spawnedEnemies.length>0 && game.waveSpawnTimer%30===0) spawnEnemy();
  // Check wave clear
  if(game.spawnedEnemies.length===0 && game.enemies.filter(e=>!e.dead).length===0) {
    if(game.bossActive && game.boss && !game.boss.dead) { /* boss still alive */ }
    else if(game.boss && game.boss.dead) {
      // Level clear!
      game.state=GS.LEVEL_CLEAR; game.levelClearTimer=0;
      explode(W/2,H/2,'#FFB800',80,6);
    } else if(!game.bossActive) {
      startNextWave();
    }
  }
  // Update entities
  game.enemies.forEach(e => e.update(game.bullets, game.players));
  game.enemies = game.enemies.filter(e=>!e.dead);
  if(game.boss) { game.boss.update(game.bullets,game.players); if(game.boss.dead&&!game.bossActive) {} }
  game.bullets.forEach(b=>b.update());
  game.bullets = game.bullets.filter(b=>!b.dead);
  game.powerups.forEach(pu=>pu.update());
  game.powerups = game.powerups.filter(pu=>!pu.dead);
  particles.forEach(p=>p.update());
  particles = particles.filter(p=>p.life>0);
  // Players
  game.players.forEach(p => { if(p.active||p.dying>0||p.respawnTimer>0) p.update(game.bullets); });
  // Check collisions
  checkCollisions();
  // Game over check
  const anyAlive = game.players.some(p=>p.active||p.dying>0||p.respawnTimer>0);
  if(!anyAlive) {
    game.state=GS.GAMEOVER; menuT=0;
    Audio.play('explode_big');
    Audio.stopMusic();
  }
  // Flash
  if(game.flashTimer>0) game.flashTimer--;
  if(game.screenFlash>0) game.screenFlash--;
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: ENGINE — DRAW
   ═══════════════════════════════════════════════════════════════════════════ */
function draw() {
  ctx.fillStyle='#000005'; ctx.fillRect(0,0,W,H);
  drawStars();
  if(game.state===GS.MENU) { drawMenu(); return; }
  if(game.state===GS.MODE) { drawModeSelect(); return; }
  // Playing / paused / level clear
  // Draw game world
  particles.forEach(p=>p.draw(ctx));
  game.powerups.forEach(pu=>pu.draw(ctx));
  game.enemies.forEach(e=>e.draw(ctx));
  if(game.boss&&!game.boss.dead) game.boss.draw(ctx);
  game.bullets.forEach(b=>b.draw(ctx));
  game.players.forEach(p=>{ if(p.active||p.dying>0||p.respawnTimer>0) p.draw(ctx); });
  // HUD
  drawHUD();
  // Flash message
  if(game.flashTimer>0) {
    const a=Math.min(1,game.flashTimer/30);
    ctx.save(); ctx.globalAlpha=a;
    ctx.shadowBlur=20; ctx.shadowColor='#FFB800';
    ctx.fillStyle='#FFB800'; ctx.font='bold 18px Orbitron'; ctx.textAlign='center';
    ctx.fillText(game.flashMsg, W/2, H/2-20);
    ctx.restore();
  }
  // Screen flash
  if(game.screenFlash>0) {
    ctx.fillStyle=`rgba(255,200,100,${game.screenFlash/15*0.4})`;
    ctx.fillRect(0,0,W,H);
  }
  if(game.state===GS.LEVEL_CLEAR) drawLevelClear();
  if(game.state===GS.GAMEOVER) { menuT++; drawGameOver(false); }
  if(game.state===GS.VICTORY) { menuT++; drawGameOver(true); }
  if(game.state===GS.PAUSED) drawPaused();
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: ENGINE — MAIN LOOP
   ═══════════════════════════════════════════════════════════════════════════ */
function loop() {
  update(); draw();
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);

// Show mobile controls always (they're nearly invisible until touch)
document.getElementById('mobile-controls').style.display = 'block';

// Apply persisted config to DOM overlays on boot.
applyConfig();

// Register audio gesture listeners and start menu music on first interaction.
Audio.resumeOnGesture();
const bootMusic = () => {
  Audio.ensure();
  Audio.playMusic(MUSIC_MENU);
  window.removeEventListener('pointerdown', bootMusic);
  window.removeEventListener('keydown',     bootMusic);
  window.removeEventListener('touchstart',  bootMusic);
};
window.addEventListener('pointerdown', bootMusic, { once: true });
window.addEventListener('keydown',     bootMusic, { once: true });
window.addEventListener('touchstart',  bootMusic, { once: true });

console.log('[1977] build', BUILD_VERSION);
</script>
