function startNextWave() {
  game.currentWave++;
  if(game.currentWave < game.waves.length) {
    game.spawnedEnemies=[...game.waves[game.currentWave]];
    showFlash('WAVE '+(game.currentWave+1)+'!');
  } else if(!game.bossActive && !game.boss) {
    // Spawn boss
    game.bossActive=true;
    game.boss = new Boss(game.level, game.diff);
    showFlash('⚠ BOSS INCOMING ⚠');
  }
}

function showFlash(msg, t=90) { game.flashMsg=msg; game.flashTimer=t; }

function spawnEnemy() {
  if(game.spawnedEnemies.length===0) return;
  const cfg = game.spawnedEnemies.shift();
  game.enemies.push(new Enemy(cfg.x, cfg.y, cfg.type, game.diff));
}

// ─── COLLISION ───────────────────────────────────────────────────────────────
function checkCollisions() {
  // Player bullets vs enemies
  game.bullets.forEach(b => {
    if(!b.isPlayer) return;
    game.enemies.forEach(e => {
      if(e.dead) return;
      if(Math.abs(b.x-e.x)<e.w/2+b.sz && Math.abs(b.y-e.y)<e.h/2+b.sz) {
        if(e.takeDamage(b.dmg)) {
          // Award score
          const scorer = game.players[0].pid===1?game.players[0]:game.players[0];
          game.players.forEach(p=>{ if(p.active) p.score+=e.pts; });
          game.totalScore+=e.pts;
          // Random power-up
          if(Math.random()<0.12) game.powerups.push(new PowerUp(e.x,e.y,PU_TYPES[rndInt(0,3)]));
        }
        b.dead=true;
      }
    });
    // Boss
    if(game.boss&&!game.boss.dead&&!game.boss.entering) {
      const bx=game.boss, bw=bx.w/2+b.sz, bh=bx.h/2+b.sz;
      if(Math.abs(b.x-bx.x)<bw && Math.abs(b.y-bx.y)<bh) {
        if(bx.takeDamage(b.dmg)) {
          game.players.forEach(p=>{ if(p.active) p.score+=bx.pts; });
          game.totalScore+=bx.pts;
          game.bossActive=false;
          if(Math.random()<0.5) game.powerups.push(new PowerUp(bx.x,bx.y,'SHIELD'));
          if(Math.random()<0.5) game.powerups.push(new PowerUp(bx.x+30,bx.y,'SHOT'));
          if(Math.random()<0.5) game.powerups.push(new PowerUp(bx.x-30,bx.y,'BOMB'));
        }
        b.dead=true;
      }
    }
  });
  // Enemy bullets vs players
  game.bullets.forEach(b => {
    if(b.isPlayer) return;
    game.players.forEach(p => {
      if(!p.active||p.dying>0||p.respawnTimer>0) return;
      if(Math.abs(b.x-p.x)<p.w/2 && Math.abs(b.y-p.y)<p.h/2) {
        p.takeDamage(); b.dead=true;
      }
    });
  });
  // Enemies vs players (collision)
  game.enemies.forEach(e => {
    if(e.dead) return;
    game.players.forEach(p => {
      if(!p.active||p.dying>0||p.respawnTimer>0) return;
      if(Math.abs(e.x-p.x)<(e.w+p.w)/2-4 && Math.abs(e.y-p.y)<(e.h+p.h)/2-4) {
        p.takeDamage(); e.takeDamage(10);
      }
    });
  });
  // Boss vs players
  if(game.boss&&!game.boss.dead&&!game.boss.entering) {
    game.players.forEach(p => {
      if(!p.active||p.dying>0||p.respawnTimer>0) return;
      if(Math.abs(game.boss.x-p.x)<game.boss.w/2 && Math.abs(game.boss.y-p.y)<game.boss.h/2) {
        p.takeDamage();
      }
    });
  }
  // Power-ups vs players
  game.powerups.forEach(pu => {
    game.players.forEach(p => {
      if(!p.active) return;
      if(dist(pu,p)<24) {
        pu.dead=true;
        switch(pu.type) {
          case 'SHOT': p.shotLevel=Math.min(3,p.shotLevel+1); showFlash('FIREPOWER UP!'); break;
          case 'SPEED': p.speed=Math.min(5.5,p.speed+0.5); showFlash('SPEED UP!'); break;
          case 'SHIELD': p.hasShield=true; p.shieldTime=600; showFlash('SHIELD!'); break;
          case 'BOMB': p.bombs=Math.min(5,p.bombs+1); showFlash('BOMB +1!'); break;
        }
      }
    });
  });
}

