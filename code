  { kind: 'action',       label: 'RESET DEFAULTS' },
  { kind: 'action',       label: 'BACK TO MENU' },
];
function handleOptionsInput(up, dn, lf, rt, ok, back) {
  if (up) { game.optionsSel = (game.optionsSel + OPTIONS_ITEMS.length - 1) % OPTIONS_ITEMS.length; Audio.play('menu_move'); return; }
  if (dn) { game.optionsSel = (game.optionsSel + 1) % OPTIONS_ITEMS.length; Audio.play('menu_move'); return; }
  const it = OPTIONS_ITEMS[game.optionsSel];
  if (it.kind === 'action') {
    if (ok) {
      Audio.play('menu_confirm');
      if (it.label.startsWith('RESET')) { Config.reset(); Audio.applyVolumes(); Toasts.push('DEFAULTS RESTORED','#88CCFF'); }
      else { game.state = GS.MENU; }
    }
    return;
  }
  if (back) { game.state = GS.MENU; Audio.play('menu_move'); return; }
  const cur = Config.get(it.key);
  let changed = false, next = cur;
  if (it.type === 'slider') {
    if (lf) next = Math.max(it.min, +(cur - it.step).toFixed(2));
    if (rt) next = Math.min(it.max, +(cur + it.step).toFixed(2));
    if (next !== cur) changed = true;
  } else if (it.type === 'enum') {
    const i = it.values.indexOf(cur);
    if (lf) { next = it.values[(i + it.values.length - 1) % it.values.length]; changed = true; }
    if (rt) { next = it.values[(i + 1) % it.values.length]; changed = true; }
  } else if (it.type === 'bool') {
    if (lf || rt || ok) { next = !cur; changed = true; }
  }
  if (changed) {
    Config.set(it.key, next);
    Audio.play('menu_move');
    if (it.key.startsWith('vol')) Audio.applyVolumes();
  }
}
