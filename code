/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: RENDER — POST-PROCESS (WebGL CRT shader)
   GLSL adapted from vendor/webgl-crt-shader/CRTShader.js (MIT).
   Stripped of Three.js uniforms we don't need; runs against WebGL1 so older
   devices still work.
   ═══════════════════════════════════════════════════════════════════════════ */
const CRT = (() => {
  let gl, out, prog, tex, vbo, uniforms;
  let lastSrc = null;
  let aberration = 0;
  let aberrationUntil = 0;
  let ready = false;

  const VS = `
    attribute vec2 aPos;
    varying vec2 vUv;
    void main() {
      vUv = aPos * 0.5 + 0.5;
      gl_Position = vec4(aPos, 0.0, 1.0);
    }`;
  const FS = `
    precision mediump float;
    uniform sampler2D uTex;
    uniform float uTime;
    uniform float uScanIntensity;
    uniform float uScanCount;
    uniform float uBrightness;
    uniform float uContrast;
    uniform float uSaturation;
    uniform float uBloom;
    uniform float uRgbShift;
    uniform float uVignette;
    uniform float uCurvature;
    uniform float uFlicker;
    varying vec2 vUv;
    const float PI = 3.14159265;
    const vec3 LUMA = vec3(0.299, 0.587, 0.114);
    vec2 curve(vec2 uv, float k) {
      vec2 c = uv * 2.0 - 1.0;
      c = c * (1.0 + dot(c, c) * k * 0.25);
      return c * 0.5 + 0.5;
    }
    void main() {
      vec2 uv = vUv;
      if (uCurvature > 0.001) {
        uv = curve(uv, uCurvature);
        if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
          gl_FragColor = vec4(0.0, 0.0, 0.0, 1.0);
          return;
        }
      }
      vec4 px = texture2D(uTex, uv);
      // Bloom — cheap cross-tap
      if (uBloom > 0.001) {
        float lum = dot(px.rgb, LUMA);
        if (lum > 0.25) {
          float r = 0.005;
          vec4 b = (texture2D(uTex, uv + vec2(r, 0.0))
                 +  texture2D(uTex, uv - vec2(r, 0.0))
                 +  texture2D(uTex, uv + vec2(0.0, r))
                 +  texture2D(uTex, uv - vec2(0.0, r))) * 0.25;
          px.rgb += b.rgb * uBloom * max(0.0, lum - 0.25);
        }
      }
      // RGB shift (chromatic aberration)
      if (uRgbShift > 0.001) {
        float s = uRgbShift * 0.006;
        px.r = texture2D(uTex, vec2(uv.x + s, uv.y)).r;
        px.b = texture2D(uTex, vec2(uv.x - s, uv.y)).b;
      }
      px.rgb *= uBrightness;
      float l = dot(px.rgb, LUMA);
      px.rgb = (px.rgb - 0.5) * uContrast + 0.5;
      px.rgb = mix(vec3(l), px.rgb, uSaturation);
      // Scanlines
      float mask = 1.0;
      if (uScanIntensity > 0.001) {
        float sp = abs(sin(uv.y * uScanCount * PI));
        mask *= 1.0 - sp * uScanIntensity;
      }
      // Flicker
      if (uFlicker > 0.001) {
        mask *= 1.0 + sin(uTime * 110.0) * uFlicker;
      }
      // Vignette
      if (uVignette > 0.001) {
        vec2 vc = uv * 2.0 - 1.0;
        float d = max(abs(vc.x), abs(vc.y));
        mask *= 1.0 - d * d * uVignette;
      }
      px.rgb *= mask;
      gl_FragColor = vec4(px.rgb, 1.0);
    }`;

  function compile(type, src) {
    const s = gl.createShader(type);
    gl.shaderSource(s, src);
    gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
      console.warn('[CRT] shader error:', gl.getShaderInfoLog(s));
      gl.deleteShader(s);
      return null;
    }
    return s;
  }

  function init(srcCanvas) {
    if (ready) return true;
    out = document.getElementById('crt-out');
    if (!out) return false;
    out.width = srcCanvas.width;
    out.height = srcCanvas.height;
    gl = out.getContext('webgl', { alpha: false, antialias: false });
    if (!gl) return false;
    const vs = compile(gl.VERTEX_SHADER, VS);
    const fs = compile(gl.FRAGMENT_SHADER, FS);
    if (!vs || !fs) return false;
    prog = gl.createProgram();
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.bindAttribLocation(prog, 0, 'aPos');
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      console.warn('[CRT] link error:', gl.getProgramInfoLog(prog));
      return false;
    }
    vbo = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, vbo);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 1,-1, -1,1, 1,1]), gl.STATIC_DRAW);
    tex = gl.createTexture();
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    uniforms = {};
    for (const name of ['uTex','uTime','uScanIntensity','uScanCount','uBrightness',
                        'uContrast','uSaturation','uBloom','uRgbShift','uVignette',
                        'uCurvature','uFlicker']) {
      uniforms[name] = gl.getUniformLocation(prog, name);
    }
    lastSrc = srcCanvas;
    ready = true;
    return true;
  }

  function draw(srcCanvas, time) {
    if (Config.get('crt') !== 'webgl') return;
    if (!ready && !init(srcCanvas)) { Config.set('crt', 'css'); return; }
    if (out.width !== srcCanvas.width || out.height !== srcCanvas.height) {
      out.width = srcCanvas.width; out.height = srcCanvas.height;
    }
    gl.viewport(0, 0, out.width, out.height);
    gl.useProgram(prog);
    gl.bindBuffer(gl.ARRAY_BUFFER, vbo);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, srcCanvas);
    const ab = time < aberrationUntil ? aberration : 0.2;
    gl.uniform1i(uniforms.uTex, 0);
    gl.uniform1f(uniforms.uTime,           time / 1000);
    gl.uniform1f(uniforms.uScanIntensity,  0.22);
    gl.uniform1f(uniforms.uScanCount,      240);
    gl.uniform1f(uniforms.uBrightness,     1.08);
    gl.uniform1f(uniforms.uContrast,       1.05);
    gl.uniform1f(uniforms.uSaturation,     1.15);
    gl.uniform1f(uniforms.uBloom,          0.55);
    gl.uniform1f(uniforms.uRgbShift,       ab);
    gl.uniform1f(uniforms.uVignette,       0.45);
    gl.uniform1f(uniforms.uCurvature,      0.18);
    gl.uniform1f(uniforms.uFlicker,        0.008);
    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
  }

  function pulseAberration(amount, ms) {
    const now = performance.now();
    aberration = Math.max(aberration, amount);
    aberrationUntil = Math.max(aberrationUntil, now + ms);
  }

  return { init, draw, pulseAberration };
})();

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: RENDER — CAMERA (shake, slow-mo, hit flash, chromatic aberration)
   ═══════════════════════════════════════════════════════════════════════════ */
const Camera = (() => {
  let shakeAmt = 0, shakeEnd = 0;
  let flashColor = null, flashEnd = 0, flashMax = 0;
  let slowEnd = 0, slowFactor = 1;

  function shake(intensity, ms) {
    if (Config.get('reducedMotion')) return;
    const now = performance.now();
    const strength = intensity * Config.get('shake');
    shakeAmt = Math.max(shakeAmt, strength);
    shakeEnd = Math.max(shakeEnd, now + ms);
  }
  function flash(color, ms) {
    const now = performance.now();
    flashColor = color;
    flashEnd = now + ms;
    flashMax = ms;
  }
  function slowMo(factor, ms) {
    if (!Config.get('slowMo') || Config.get('reducedMotion')) return;
    const now = performance.now();
    slowFactor = factor;
    slowEnd = Math.max(slowEnd, now + ms);
  }
  function timeScale() {
    return performance.now() < slowEnd ? slowFactor : 1;
  }
  function preRender(ctx, time) {
    if (time < shakeEnd) {
      const t = (shakeEnd - time) / 400;
      const mag = shakeAmt * t * 12;
      ctx.translate((Math.random() - 0.5) * mag, (Math.random() - 0.5) * mag);
    } else {
      shakeAmt = 0;
    }
  }
  function postRender(ctx, time) {
    if (flashColor && time < flashEnd) {
      const a = ((flashEnd - time) / flashMax) * 0.5;
      ctx.fillStyle = flashColor;
      ctx.globalAlpha = a;
      ctx.fillRect(0, 0, W, H);
      ctx.globalAlpha = 1;
    }
  }

  return { shake, flash, slowMo, timeScale, preRender, postRender };
})();

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: RENDER — CONFETTI (DIY, ~40 lines; vendor/canvas-confetti as ref)
   ═══════════════════════════════════════════════════════════════════════════ */
const Confetti = (() => {
  const pieces = [];
  function burst(x, y, colors, count) {
    const n = Config.get('reducedMotion') ? Math.ceil(count * 0.4) : count;
    for (let i = 0; i < n; i++) {
      const ang = -Math.PI / 2 + (Math.random() - 0.5) * Math.PI;
      const spd = 4 + Math.random() * 6;
      pieces.push({
        x, y,
        vx: Math.cos(ang) * spd + (Math.random() - 0.5) * 2,
        vy: Math.sin(ang) * spd,
        rot: Math.random() * Math.PI * 2,
        vrot: (Math.random() - 0.5) * 0.5,
        w: 4 + Math.random() * 4,
        h: 2 + Math.random() * 3,
        color: colors[Math.floor(Math.random() * colors.length)],
        life: 80 + Math.random() * 60,
      });
    }
  }
  function update() {
    for (let i = pieces.length - 1; i >= 0; i--) {
      const p = pieces[i];
      p.x += p.vx; p.y += p.vy;
      p.vy += 0.15; p.vx *= 0.99;
      p.rot += p.vrot;
      p.life--;
      if (p.life <= 0 || p.y > H + 40) pieces.splice(i, 1);
    }
  }
  function draw(ctx) {
    for (const p of pieces) {
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot);
      ctx.fillStyle = p.color;
      ctx.globalAlpha = Math.min(1, p.life / 40);
      ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
      ctx.restore();
    }
    ctx.globalAlpha = 1;
  }
  return { burst, update, draw };
})();

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: UTILITY
   ═══════════════════════════════════════════════════════════════════════════ */
const rnd = (a,b) => Math.random()*(b-a)+a;
const rndInt = (a,b) => Math.floor(rnd(a,b+1));
const clamp = (v,a,b) => Math.max(a,Math.min(b,v));
const dist = (a,b) => Math.hypot(a.x-b.x,a.y-b.y);
const lerp = (a,b,t) => a+(b-a)*t;

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: RENDER — CANVAS SETUP
   ═══════════════════════════════════════════════════════════════════════════ */
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d');
canvas.width = W; canvas.height = H;

function resize() {
  const vw = window.innerWidth, vh = window.innerHeight;
  const scale = Math.min(vw/W, vh/H);
  canvas.style.width  = (W*scale)+'px';
  canvas.style.height = (H*scale)+'px';
  const crtOut = document.getElementById('crt-out');
  if (crtOut) {
    crtOut.style.width  = (W*scale)+'px';
    crtOut.style.height = (H*scale)+'px';
  }
  const mc = document.getElementById('mobile-controls');
  mc.style.width  = (W*scale)+'px';
  mc.style.height = (H*scale)+'px';
  mc.style.left = ((vw - W*scale)/2)+'px';
  mc.style.top  = ((vh - H*scale)/2)+'px';
  const wrap = document.getElementById('wrapper');
  wrap.style.width  = (W*scale)+'px';
  wrap.style.height = (H*scale)+'px';
}
window.addEventListener('resize', resize); resize();

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: RENDER — STARFIELD (3 parallax layers + nebula)
   ═══════════════════════════════════════════════════════════════════════════ */
const STARS_FAR = Array.from({length:80}, () => ({
  x:rnd(0,W), y:rnd(0,H), spd:rnd(0.08,0.25), sz:rnd(0.5,1.2),
  bright:rnd(0.15,0.35), hue: Math.random() < 0.2 ? '#88AACC' : '#CCCCFF'
}));
const STARS_MID = Array.from({length:80}, () => ({
  x:rnd(0,W), y:rnd(0,H), spd:rnd(0.35,0.8), sz:rnd(0.8,1.8),
  bright:rnd(0.35,0.7), hue:'#FFEEDD'
}));
const STARS_NEAR = Array.from({length:60}, () => ({
  x:rnd(0,W), y:rnd(0,H), spd:rnd(1.0,2.2), sz:rnd(1.2,2.4),
  bright:rnd(0.6,0.95), hue:'#FFE8B0'
}));
const NEBULAE = Array.from({length:3}, () => ({
  x:rnd(0,W), y:rnd(-H, H), r:rnd(80,160),
  hue: ['#221155','#551144','#113355'][Math.floor(Math.random()*3)],
  spd:rnd(0.05,0.12),
}));

function drawStarLayer(layer) {
  layer.forEach(s => {
    s.y += s.spd;
    if(s.y > H) { s.y = -2; s.x = rnd(0,W); }
    ctx.fillStyle = s.hue.length === 7
      ? `rgba(${parseInt(s.hue.slice(1,3),16)},${parseInt(s.hue.slice(3,5),16)},${parseInt(s.hue.slice(5,7),16)},${s.bright})`
      : s.hue;
    ctx.fillRect(s.x, s.y, s.sz, s.sz*2);
  });
}

function drawStars() {
  // Nebulae — soft background blobs
  NEBULAE.forEach(n => {
    n.y += n.spd;
    if (n.y > H + n.r) { n.y = -n.r; n.x = rnd(0,W); }
    const grad = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, n.r);
    grad.addColorStop(0, n.hue + 'AA');
    grad.addColorStop(1, n.hue + '00');
    ctx.fillStyle = grad;
    ctx.fillRect(n.x - n.r, n.y - n.r, n.r * 2, n.r * 2);
  });
  drawStarLayer(STARS_FAR);
  drawStarLayer(STARS_MID);
  drawStarLayer(STARS_NEAR);
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: RENDER — PARTICLES
   Extended from the Phase 1 class: optional trail, gravity, drag, rotation,
   color-over-life, size-over-life, and glow rendering.
   ═══════════════════════════════════════════════════════════════════════════ */
class Particle {
  constructor(x,y,vx,vy,color,life,sz,opts) {
    opts = opts || {};
    this.x=x; this.y=y; this.vx=vx; this.vy=vy;
    this.color=color; this.life=life; this.maxLife=life; this.sz=sz;
    this.gravity = opts.gravity !== undefined ? opts.gravity : 0.05;
    this.drag    = opts.drag    !== undefined ? opts.drag    : 1.0;
    this.glow    = opts.glow    !== undefined ? opts.glow    : 0;
    this.shape   = opts.shape   || 'circle';                 // 'circle'|'square'|'streak'
    this.colorEnd = opts.colorEnd || null;                   // fade to this color
    this.trail   = opts.trail || 0;                          // # of trail samples
    this.history = this.trail ? [] : null;
  }
  update() {
    if (this.history) {
      this.history.push(this.x, this.y);
      if (this.history.length > this.trail * 2) this.history.splice(0, 2);
    }
    this.x += this.vx; this.y += this.vy;
    this.vy += this.gravity;
    this.vx *= this.drag; this.vy *= this.drag;
    this.life--;
  }
  draw(ctx) {
    const a = Math.max(0, this.life / this.maxLife);
    ctx.globalAlpha = a;
    if (this.glow > 0) { ctx.shadowBlur = this.glow; ctx.shadowColor = this.color; }
    let color = this.color;
    if (this.colorEnd) {
      // lerp rgb
      const lerpHex = (c1, c2, t) => {
        const p = h => [parseInt(h.slice(1,3),16), parseInt(h.slice(3,5),16), parseInt(h.slice(5,7),16)];
        const [r1,g1,b1] = p(c1), [r2,g2,b2] = p(c2);
        return `rgb(${(r1+(r2-r1)*t)|0},${(g1+(g2-g1)*t)|0},${(b1+(b2-b1)*t)|0})`;
      };
      color = lerpHex(this.color, this.colorEnd, 1 - a);
    }
    if (this.history && this.history.length >= 4) {
      ctx.strokeStyle = color;
      ctx.lineWidth = this.sz * a;
      ctx.beginPath();
      ctx.moveTo(this.history[0], this.history[1]);
      for (let i = 2; i < this.history.length; i += 2) ctx.lineTo(this.history[i], this.history[i+1]);
      ctx.lineTo(this.x, this.y);
      ctx.stroke();
    }
    ctx.fillStyle = color;
    if (this.shape === 'square') {
      const s = this.sz * a;
      ctx.fillRect(this.x - s, this.y - s, s * 2, s * 2);
    } else if (this.shape === 'streak') {
      const len = Math.hypot(this.vx, this.vy) * 3;
      const ang = Math.atan2(this.vy, this.vx);
      ctx.save(); ctx.translate(this.x, this.y); ctx.rotate(ang);
      ctx.fillRect(-len, -this.sz * a * 0.5, len, this.sz * a);
      ctx.restore();
    } else {
      ctx.beginPath(); ctx.arc(this.x, this.y, this.sz * a, 0, Math.PI * 2); ctx.fill();
    }
    if (this.glow > 0) ctx.shadowBlur = 0;
    ctx.globalAlpha = 1;
  }
}

let particles = [];
function explode(x,y,color,count=20,speed=3) {
  const n = Config.get('reducedMotion') ? Math.ceil(count*0.5) : count;
  for(let i=0;i<n;i++) {
    const ang = rnd(0,Math.PI*2);
    const spd = rnd(0.5,speed);
    particles.push(new Particle(x,y,Math.cos(ang)*spd,Math.sin(ang)*spd,color,rnd(22,44),rnd(1.2,4.2), {
      glow: 8, drag: 0.96, gravity: 0.04, colorEnd: '#221100',
    }));
  }
  // Add a few fast streak shards
  const shards = Math.ceil(n * 0.2);
  for (let i = 0; i < shards; i++) {
    const ang = rnd(0, Math.PI * 2);
    const spd = rnd(speed, speed * 2);
    particles.push(new Particle(x, y, Math.cos(ang)*spd, Math.sin(ang)*spd, color, rnd(10,18), rnd(1.5,3), {
      shape: 'streak', glow: 10, gravity: 0.0, drag: 0.94,
    }));
  }
}
function sparkle(x,y,color,count=8) {
  const n = Config.get('reducedMotion') ? Math.ceil(count*0.5) : count;
  for(let i=0;i<n;i++) {
    const ang = rnd(0,Math.PI*2);
    particles.push(new Particle(x,y,Math.cos(ang)*rnd(1,3),Math.sin(ang)*rnd(1,3),color,rnd(10,20),rnd(1,2), {
      glow: 6, drag: 0.9,
    }));
  }
}
function thruster(x, y, color) {
  if (Config.get('reducedMotion')) return;
  particles.push(new Particle(x + rnd(-2,2), y, rnd(-0.3, 0.3), rnd(1.5, 3), color, rnd(10, 18), rnd(1.5, 2.5), {
    glow: 8, drag: 0.92, gravity: 0, colorEnd: '#221100', trail: 3,
  }));
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: INPUT (Phase 5 adds gamepad + nipplejs touch)
   ═══════════════════════════════════════════════════════════════════════════ */
const keys = {};
window.addEventListener('keydown', e => { keys[e.code]=true; e.preventDefault(); });
window.addEventListener('keyup',   e => { keys[e.code]=false; });

// Touch input state
const touch = {
  p1: { dx:0, dy:0, fire:false, id:null, ox:0, oy:0 },
  p2: { dx:0, dy:0, fire:false, id:null, ox:0, oy:0 }
};

function getTouchPos(e) {
  const rect = canvas.getBoundingClientRect();
  const scaleX = W / rect.width;
  const scaleY = H / rect.height;
  return { x:(e.clientX-rect.left)*scaleX, y:(e.clientY-rect.top)*scaleY };
}

const mc = document.getElementById('mobile-controls');
mc.addEventListener('touchstart', e => {
  Array.from(e.changedTouches).forEach(t => {
    const pos = getTouchPos(t);
    const side = pos.x < W/2 ? 'p1' : 'p2';
    if(!touch[side].id) {
      touch[side].id = t.identifier;
      touch[side].ox = pos.x; touch[side].oy = pos.y;
      touch[side].dx=0; touch[side].dy=0; touch[side].fire=false;
    }
  });
},{passive:false});

mc.addEventListener('touchmove', e => {
  e.preventDefault();
  Array.from(e.changedTouches).forEach(t => {
    const pos = getTouchPos(t);
    ['p1','p2'].forEach(p => {
      if(touch[p].id === t.identifier) {
        touch[p].dx = clamp((pos.x - touch[p].ox)/40, -1, 1);
        touch[p].dy = clamp((pos.y - touch[p].oy)/40, -1, 1);
      }
    });
  });
},{passive:false});

['touchend','touchcancel'].forEach(ev => mc.addEventListener(ev, e => {
  Array.from(e.changedTouches).forEach(t => {
    ['p1','p2'].forEach(p => {
      if(touch[p].id === t.identifier) {
        touch[p].id=null; touch[p].dx=0; touch[p].dy=0;
      }
    });
  });
}));

// Fire buttons
document.getElementById('fire1-btn').addEventListener('touchstart', e => { touch.p1.fire=true; e.preventDefault(); });
document.getElementById('fire1-btn').addEventListener('touchend', e => { touch.p1.fire=false; });
document.getElementById('fire2-btn').addEventListener('touchstart', e => { touch.p2.fire=true; e.preventDefault(); });
document.getElementById('fire2-btn').addEventListener('touchend', e => { touch.p2.fire=false; });

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: ENTITIES — BULLET
   ═══════════════════════════════════════════════════════════════════════════ */
class Bullet {
  constructor(x,y,vx,vy,color,dmg,sz,isPlayer) {
    this.x=x; this.y=y; this.vx=vx; this.vy=vy;
    this.color=color; this.dmg=dmg; this.sz=sz; this.isPlayer=isPlayer; this.dead=false;
  }
  update() {
    if (this._px === undefined) { this._px = this.x; this._py = this.y; }
    else { this._px = this.x; this._py = this.y; }
    this.x+=this.vx; this.y+=this.vy;
    if(this.y<-20||this.y>H+20||this.x<-20||this.x>W+20) this.dead=true;
  }
  draw(ctx) {
    ctx.save();
    ctx.shadowBlur=12; ctx.shadowColor=this.color;
    // Trail line
    if (this._px !== undefined) {
      ctx.strokeStyle = this.color;
      ctx.globalAlpha = 0.45;
      ctx.lineWidth = this.sz * 0.9;
      ctx.beginPath();
      ctx.moveTo(this._px, this._py);
      ctx.lineTo(this.x, this.y);
      ctx.stroke();
      ctx.globalAlpha = 1;
    }
    ctx.fillStyle=this.color;
    ctx.beginPath();
    ctx.ellipse(this.x, this.y, this.sz, this.sz*2.5, 0, 0, Math.PI*2);
    ctx.fill();
    // bright core
    ctx.fillStyle = '#FFFFFF';
    ctx.globalAlpha = 0.7;
    ctx.beginPath();
    ctx.ellipse(this.x, this.y, this.sz*0.35, this.sz*1.2, 0, 0, Math.PI*2);
    ctx.fill();
    ctx.globalAlpha = 1;
    ctx.restore();
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: ENTITIES — POWER-UP
   ═══════════════════════════════════════════════════════════════════════════ */
const PU_TYPES = ['SHOT','SPEED','SHIELD','BOMB'];
class PowerUp {
  constructor(x,y,type) {
    this.x=x; this.y=y; this.type=type; this.dead=false; this.t=0;
    this.colors = { SHOT:'#FF8800', SPEED:'#00FFFF', SHIELD:'#4488FF', BOMB:'#FF4466' };
  }
  update() { this.y += 1.2; this.t++; if(this.y>H+20) this.dead=true; }
  draw(ctx) {
    const c = this.colors[this.type];
    const pulse = Math.sin(this.t*0.15)*3;
    ctx.save();
    ctx.shadowBlur=14+pulse; ctx.shadowColor=c;
    ctx.strokeStyle=c; ctx.lineWidth=2;
    ctx.beginPath(); ctx.arc(this.x,this.y,12+pulse,0,Math.PI*2); ctx.stroke();
    ctx.fillStyle=c; ctx.font='bold 9px Share Tech Mono'; ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText(this.type[0], this.x, this.y);
    ctx.restore();
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: ENTITIES — PLAYER
   ═══════════════════════════════════════════════════════════════════════════ */
class Player {
  constructor(x,y,pid,color) {
    this.x=x; this.y=y; this.pid=pid; this.color=color;
    this.w=24; this.h=28; this.dead=false; this.invTime=0;
    this.shotLevel=1; this.speed=3.2; this.hasShield=false; this.shieldTime=0;
    this.bombs=3; this.fireTimer=0; this.fireRate=8;
    this.score=0; this.t=0; this.thrusterT=0;
    this.lives = DIFF_CFG[game.diff].lives;
    this.dying=0; this.respawnTimer=0; this.active=true;
  }
  getInput() {
    const spd = this.speed;
    let dx=0, dy=0, fire=false, bomb=false;
    if(this.pid===1) {
      if(keys['KeyA']||keys['ArrowLeft']) dx=-1;
      if(keys['KeyD']||keys['ArrowRight']) dx=1;
      if(keys['KeyW']||keys['ArrowUp']) dy=-1;
      if(keys['KeyS']||keys['ArrowDown']) dy=1;
      fire = keys['Space']||keys['KeyZ'];
      bomb = keys['KeyX'];
      // touch p1
      dx += touch.p1.dx; dy += touch.p1.dy;
      if(touch.p1.fire) fire=true;
    } else {
      if(keys['Numpad4']||keys['KeyJ']) dx=-1;
      if(keys['Numpad6']||keys['KeyL']) dx=1;
      if(keys['Numpad8']||keys['KeyI']) dy=-1;
      if(keys['Numpad5']||keys['KeyK']) dy=1;
      fire = keys['Enter']||keys['NumpadEnter']||keys['KeyM'];
      bomb = keys['KeyN'];
      dx += touch.p2.dx; dy += touch.p2.dy;
      if(touch.p2.fire) fire=true;
    }
    return {dx:clamp(dx,-1,1), dy:clamp(dy,-1,1), fire, bomb};
  }
  update(bullets) {
    this.t++;
    if(this.dying>0) { this.dying--; return; }
    if(this.respawnTimer>0) { this.respawnTimer--; if(this.respawnTimer===0) { this.invTime=120; } return; }
    if(this.invTime>0) this.invTime--;
    if(this.hasShield) { this.shieldTime--; if(this.shieldTime<=0) this.hasShield=false; }
    const inp = this.getInput();
    this.x = clamp(this.x + inp.dx*this.speed, this.w/2, W-this.w/2);
    this.y = clamp(this.y + inp.dy*this.speed, this.h/2, H-this.h/2);
    this.fireTimer++;
    if(inp.fire && this.fireTimer >= this.fireRate) {
      this.fireTimer=0; this.shoot(bullets);
    }
    if(inp.bomb && this.bombs>0) { this.useBomb(bullets); this.bombs=Math.max(0,this.bombs-1); }
    this.thrusterT++;
    // thruster particles (streaked, trail-enabled)
    if(this.t%2===0) thruster(this.x, this.y+this.h/2, this.pid===1?'#FFAA33':'#44AAFF');
  }
  shoot(bullets) {
    const spd = -9;
    const c = this.pid===1 ? '#FFE066' : '#66EEFF';
    if(this.shotLevel===1) {
      bullets.push(new Bullet(this.x, this.y-this.h/2, 0, spd, c, 1, 2.5, true));
      Audio.play('shoot');
    } else if(this.shotLevel===2) {
      bullets.push(new Bullet(this.x-7, this.y-this.h/2, 0, spd, c, 1, 2.5, true));
      bullets.push(new Bullet(this.x+7, this.y-this.h/2, 0, spd, c, 1, 2.5, true));
      Audio.play('shoot');
    } else if(this.shotLevel>=3) {
      bullets.push(new Bullet(this.x, this.y-this.h/2, 0, spd, c, 1.5, 2.5, true));
      bullets.push(new Bullet(this.x-10, this.y-this.h/2, -0.5, spd, c, 1, 2, true));
      bullets.push(new Bullet(this.x+10, this.y-this.h/2,  0.5, spd, c, 1, 2, true));
      Audio.play('shoot_powered');
    }
  }
  useBomb(bullets) {
    explode(this.x, this.y, this.color, 60, 6);
    // screen flash
    game.screenFlash = 10;
    Audio.play('bomb');
    Audio.duck(0.3, 600);
    Camera.shake(0.9, 450);
    Camera.flash('#FFEEBB', 180);
    CRT.pulseAberration(2.5, 600);
    // kill all enemy bullets
    game.bullets = game.bullets.filter(b => b.isPlayer);
    // damage all enemies
    game.enemies.forEach(e => { e.hp -= 5; if(e.hp<=0) e.hp=0; });
  }
  takeDamage() {
    if(this.invTime>0||this.hasShield||this.dying>0) return;
    this.lives--;
    this.invTime=0;
    this.dying=60;
    explode(this.x, this.y, this.color, 60, 4);
    Audio.play('hit_player');
    Audio.play('explode_big');
    Audio.duck(0.4, 500);
    Camera.shake(1.0, 500);
    Camera.flash('#FF4466', 300);
    Camera.slowMo(0.35, 280);
    CRT.pulseAberration(2.0, 500);
    if(this.lives<=0) {
      this.active=false;
      this.dead=true;
    } else {
      this.respawnTimer=90;
      this.x = this.pid===1 ? W*0.35 : W*0.65;
      this.y = H-80;
    }
  }
  draw(ctx) {
    if(this.dying>0) {
      const a = this.dying/60;
      ctx.globalAlpha = a;
    }
    if(this.respawnTimer>0) { ctx.globalAlpha=0; }
    if(this.invTime>0 && Math.floor(this.invTime/5)%2===0) { ctx.globalAlpha=0.3; }
    // Thruster flame
    if(this.dying===0 && this.respawnTimer===0) {
      const flameLen = 10+Math.sin(this.t*0.4)*5;
      const grad = ctx.createLinearGradient(this.x,this.y+this.h/2,this.x,this.y+this.h/2+flameLen);
      grad.addColorStop(0, this.pid===1?'#FFA000':'#0088FF');
      grad.addColorStop(1,'transparent');
      ctx.fillStyle=grad;
      ctx.beginPath(); ctx.ellipse(this.x,this.y+this.h/2+flameLen/2,5,flameLen/2,0,0,Math.PI*2); ctx.fill();
    }
    // Ship body
    ctx.save();
    ctx.shadowBlur=16; ctx.shadowColor=this.color;
    ctx.fillStyle=this.color;
    // Main body
    ctx.beginPath();
    ctx.moveTo(this.x, this.y-this.h/2);
    ctx.lineTo(this.x-this.w/2, this.y+this.h/2);
    ctx.lineTo(this.x-this.w/4, this.y+this.h/4);
    ctx.lineTo(this.x, this.y+this.h/3);
    ctx.lineTo(this.x+this.w/4, this.y+this.h/4);
    ctx.lineTo(this.x+this.w/2, this.y+this.h/2);
    ctx.closePath(); ctx.fill();
    // Cockpit
    ctx.fillStyle='#001133';
    ctx.beginPath(); ctx.ellipse(this.x, this.y-this.h/8, 5, 7, 0, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle='rgba(100,200,255,0.8)';
    ctx.beginPath(); ctx.ellipse(this.x, this.y-this.h/8, 3, 5, 0, 0, Math.PI*2); ctx.fill();
    // Shield
    if(this.hasShield) {
      ctx.strokeStyle='rgba(68,136,255,0.8)'; ctx.lineWidth=2; ctx.shadowBlur=20; ctx.shadowColor='#4488FF';
      ctx.beginPath(); ctx.arc(this.x,this.y,this.h*0.7,0,Math.PI*2); ctx.stroke();
    }
    ctx.restore();
    ctx.globalAlpha=1;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: ENTITIES — ENEMY
   ═══════════════════════════════════════════════════════════════════════════ */
class Enemy {
  constructor(x,y,type,diff) {
    this.x=x; this.y=y; this.type=type; this.diff=diff;
    this.dead=false; this.t=0; this.fireTimer=0;
    this.vx=0; this.vy=0;
    const dc = DIFF_CFG[diff];
    switch(type) {
      case 'basic':  this.w=22;this.h=20;this.hp=2; this.maxHp=2; this.pts=100; this.color='#FF6633'; this.vy=0.8*dc.enemySpd; break;
      case 'weaver': this.w=20;this.h=18;this.hp=3; this.maxHp=3; this.pts=150; this.color='#FF33AA'; this.vy=0.9*dc.enemySpd; break;
      case 'bomber': this.w=32;this.h=28;this.hp=6; this.maxHp=6; this.pts=300; this.color='#AA44FF'; this.vy=0.5*dc.enemySpd; break;
      case 'kamikaze':this.w=18;this.h=16;this.hp=1;this.maxHp=1;this.pts=200; this.color='#FFAA00'; this.vy=1.5*dc.enemySpd; break;
      case 'elite':  this.w=26;this.h=24;this.hp=8; this.maxHp=8; this.pts=400; this.color='#00FFAA'; this.vy=1.0*dc.enemySpd; break;
    }
    this.fireRate = Math.max(40, 100/dc.fireRate);
    this.initX=x; this.initY=y;
  }
  update(bullets, players) {
    this.t++;
    this.fireTimer++;
    const dc = DIFF_CFG[this.diff];
    switch(this.type) {
      case 'basic': this.y+=this.vy; break;
      case 'weaver': this.x=this.initX+Math.sin(this.t*0.04)*80; this.y+=this.vy; break;
      case 'bomber': this.y+=this.vy; break;
      case 'kamikaze': {
        const tgt = this.getNearestPlayer(players);
        if(tgt) {
          const dx=tgt.x-this.x, dy=tgt.y-this.y, d=Math.hypot(dx,dy)||1;
          this.x+=dx/d*this.vy*1.8; this.y+=dy/d*this.vy*1.8;
        } else { this.y+=this.vy; }
        break;
      }
      case 'elite': this.x=this.initX+Math.sin(this.t*0.06)*60; this.y+=this.vy; break;
    }
    if(this.y > H+50) this.dead=true;
    // Shooting
    if(this.type!=='kamikaze' && this.fireTimer>=this.fireRate) {
      this.fireTimer=0; this.shoot(bullets, players);
    }
  }
  getNearestPlayer(players) {
    const alive = players.filter(p=>p.active&&!p.dying&&p.respawnTimer===0);
    if(!alive.length) return null;
    return alive.reduce((a,b)=>dist(this,a)<dist(this,b)?a:b);
  }
  shoot(bullets, players) {
    const tgt = this.getNearestPlayer(players);
    const c = '#FF3333';
    if(this.type==='bomber') {
      for(let i=-2;i<=2;i++) bullets.push(new Bullet(this.x,this.y+this.h/2,i*0.8,3,c,1,3,false));
    } else if(this.type==='elite') {
      const dx=tgt?(tgt.x-this.x):0, dy=tgt?(tgt.y-this.y):1, d=Math.hypot(dx,dy)||1;
      bullets.push(new Bullet(this.x,this.y+this.h/2,dx/d*3,dy/d*3,c,1,2.5,false));
      bullets.push(new Bullet(this.x,this.y+this.h/2,-dx/d*3+1.5,dy/d*3,c,1,2.5,false));
    } else if(tgt) {
      const dx=tgt.x-this.x, dy=tgt.y-this.y, d=Math.hypot(dx,dy)||1;
      bullets.push(new Bullet(this.x,this.y+this.h/2,dx/d*3,dy/d*3,c,1,2,false));
    }
  }
  takeDamage(dmg) {
    this.hp -= dmg;
    sparkle(this.x,this.y,this.color,4);
    Audio.play('hit_enemy');
    if(this.hp<=0) {
      this.dead=true;
      explode(this.x,this.y,this.color,36,3.5);
      Audio.play('explode_small');
      Camera.shake(0.2, 120);
      return true;
    }
    return false;
  }
  draw(ctx) {
    ctx.save();
    ctx.shadowBlur=10; ctx.shadowColor=this.color;
    ctx.fillStyle=this.color;
    switch(this.type) {
      case 'basic': {
        ctx.beginPath();
        ctx.moveTo(this.x,this.y+this.h/2);
        ctx.lineTo(this.x-this.w/2,this.y-this.h/2);
        ctx.lineTo(this.x+this.w/2,this.y-this.h/2);
        ctx.closePath(); ctx.fill(); break;
      }
      case 'weaver': {
        ctx.beginPath();
        ctx.moveTo(this.x,this.y+this.h/2);
        ctx.lineTo(this.x-this.w/2,this.y-this.h/4);
        ctx.lineTo(this.x-this.w/4,this.y-this.h/2);
        ctx.lineTo(this.x+this.w/4,this.y-this.h/2);
        ctx.lineTo(this.x+this.w/2,this.y-this.h/4);
        ctx.closePath(); ctx.fill(); break;
      }
      case 'bomber': {
        ctx.beginPath();
        ctx.ellipse(this.x,this.y,this.w/2,this.h/2,0,0,Math.PI*2); ctx.fill();
        ctx.fillStyle='#660044';
        ctx.beginPath(); ctx.ellipse(this.x,this.y,this.w/4,this.h/3,0,0,Math.PI*2); ctx.fill(); break;
      }
      case 'kamikaze': {
        ctx.beginPath();
        ctx.moveTo(this.x,this.y+this.h/2);
        ctx.lineTo(this.x-this.w/3,this.y-this.h/2);
        ctx.lineTo(this.x,this.y-this.h/4);
        ctx.lineTo(this.x+this.w/3,this.y-this.h/2);
        ctx.closePath(); ctx.fill(); break;
      }
      case 'elite': {
        const s = this.t*0.03;
        ctx.beginPath();
        for(let i=0;i<6;i++){
          const a=i*Math.PI/3+s;
          ctx[i===0?'moveTo':'lineTo'](this.x+Math.cos(a)*this.w/2,this.y+Math.sin(a)*this.h/2);
        }
        ctx.closePath(); ctx.fill(); break;
      }
    }
    // HP bar
    if(this.hp<this.maxHp && this.hp>0) {
      const bw=this.w; const pct=this.hp/this.maxHp;
      ctx.fillStyle='#333'; ctx.fillRect(this.x-bw/2,this.y-this.h/2-8,bw,4);
      ctx.fillStyle=pct>0.5?'#44FF44':pct>0.25?'#FFAA00':'#FF4444';
      ctx.fillRect(this.x-bw/2,this.y-this.h/2-8,bw*pct,4);
    }
    ctx.restore();
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: ENTITIES — BOSS
   ═══════════════════════════════════════════════════════════════════════════ */
class Boss {
  constructor(level, diff) {
    this.x=W/2; this.y=-80; this.targetY=110; this.diff=diff;
    this.w=80; this.h=60; this.t=0; this.dead=false; this.phase=0;
    const dc=DIFF_CFG[diff];
    const base = [500,800,1200,1600,2200,3000][level-1]||1000;
    this.maxHp = Math.floor(base*dc.bossHp);
    this.hp=this.maxHp;
    this.pts=base*10;
    this.fireTimer=0;
    this.fireRate=Math.max(20,60/dc.fireRate);
    this.colors=['#FF4466','#AA00FF','#FF8800','#00FFAA','#FF2200','#FFFFFF'];
    this.color=this.colors[level-1]||'#FF4466';
    this.vx=1.2*dc.enemySpd; this.vy=0;
    this.entering=true;
    this.armAngle=0; this.shieldArc=0;
  }
  update(bullets, players) {
    this.t++;
    this.armAngle += 0.04;
    if(this.entering) { this.y=lerp(this.y,this.targetY,0.02); if(Math.abs(this.y-this.targetY)<1){this.y=this.targetY;this.entering=false;} return; }
    // Phase transitions
    const hpPct = this.hp/this.maxHp;
    if(hpPct<0.5&&this.phase===0) { this.phase=1; this.onPhaseChange(); }
    if(hpPct<0.25&&this.phase===1) { this.phase=2; this.onPhaseChange(); }
    // Movement
    this.x += this.vx;
    if(this.x>W-this.w/2||this.x<this.w/2) this.vx*=-1;
    if(this.phase>=1) { this.y=this.targetY+Math.sin(this.t*0.02)*40; }
    this.fireTimer++;
    const rate = this.phase===2?this.fireRate*0.5:this.fireRate;
    if(this.fireTimer>=rate) { this.fireTimer=0; this.shoot(bullets,players); }
    // Shield arc rotation for phase 2
    if(this.phase>=2) this.shieldArc += 0.06;
  }
  shoot(bullets, players) {
    const tgt = players.filter(p=>p.active&&!p.dying&&p.respawnTimer===0);
    const c='#FF2222';
    if(this.phase===0) {
      // aimed shots
      tgt.forEach(t=>{ const dx=t.x-this.x,dy=t.y-this.y,d=Math.hypot(dx,dy)||1;
        bullets.push(new Bullet(this.x,this.y+this.h/2,dx/d*4,dy/d*4,c,1,3,false)); });
    } else if(this.phase===1) {
      // spread
      for(let i=-3;i<=3;i++) bullets.push(new Bullet(this.x,this.y+this.h/2,i*1.2,4,c,1,3,false));
      if(tgt[0]){ const dx=tgt[0].x-this.x,dy=tgt[0].y-this.y,d=Math.hypot(dx,dy)||1;
        bullets.push(new Bullet(this.x,this.y+this.h/2,dx/d*5,dy/d*5,'#FF8800',2,4,false));}
    } else {
      // radial burst
      for(let i=0;i<12;i++){const a=i*Math.PI/6+this.t*0.01;
        bullets.push(new Bullet(this.x,this.y,Math.cos(a)*4,Math.sin(a)*4,'#FF0044',1,3,false));}
      tgt.forEach(t=>{ const dx=t.x-this.x,dy=t.y-this.y,d=Math.hypot(dx,dy)||1;
        bullets.push(new Bullet(this.x,this.y,dx/d*6,dy/d*6,'#FF8800',2,5,false)); });
    }
  }
  onPhaseChange() {
    explode(this.x, this.y, this.color, 40, 4);
    Camera.shake(0.5, 260);
    CRT.pulseAberration(1.2, 350);
    Audio.play('boss_warn');
  }
  takeDamage(dmg) {
    if(this.entering) return false;
    this.hp-=dmg; sparkle(this.x,this.y,this.color,3);
    Audio.play('hit_enemy');
    if(this.hp<=0){
      this.dead=true;
      explode(this.x,this.y,this.color,120,6);
      Audio.play('explode_big');
      Audio.duck(0.3, 700);
      Camera.shake(1.0, 600);
      Camera.flash('#FFEEBB', 220);
      Camera.slowMo(0.25, 450);
      CRT.pulseAberration(3.0, 700);
      Confetti.burst(this.x, this.y, ['#FFB800','#FF4466','#44FF88','#44AAFF','#FFEEBB'], 140);
      return true;
    }
    return false;
  }
  draw(ctx) {
    ctx.save();
    ctx.shadowBlur=20; ctx.shadowColor=this.color;
    // Main hull
    ctx.fillStyle=this.color;
    ctx.beginPath();
    ctx.moveTo(this.x,this.y-this.h/2);
    ctx.lineTo(this.x-this.w/2,this.y-this.h/4);
    ctx.lineTo(this.x-this.w/2,this.y+this.h/3);
    ctx.lineTo(this.x-this.w/4,this.y+this.h/2);
    ctx.lineTo(this.x+this.w/4,this.y+this.h/2);
    ctx.lineTo(this.x+this.w/2,this.y+this.h/3);
    ctx.lineTo(this.x+this.w/2,this.y-this.h/4);
    ctx.closePath(); ctx.fill();
    // Core
    ctx.fillStyle='rgba(0,0,0,0.6)';
    ctx.beginPath(); ctx.ellipse(this.x,this.y,this.w/4,this.h/4,0,0,Math.PI*2); ctx.fill();
    ctx.shadowBlur=30; ctx.shadowColor='#FFFFFF';
    ctx.strokeStyle='rgba(255,255,255,0.9)'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.ellipse(this.x,this.y,this.w/5,this.h/5,0,0,Math.PI*2); ctx.stroke();
    // Arms
    for(let i=0;i<4;i++){
      const a=this.armAngle+i*Math.PI/2;
      ctx.strokeStyle=this.color; ctx.lineWidth=4; ctx.shadowBlur=15;
      ctx.beginPath(); ctx.moveTo(this.x,this.y);
      ctx.lineTo(this.x+Math.cos(a)*this.w*0.7,this.y+Math.sin(a)*this.h*0.7); ctx.stroke();
      ctx.fillStyle=this.color;
      ctx.beginPath(); ctx.arc(this.x+Math.cos(a)*this.w*0.7,this.y+Math.sin(a)*this.h*0.7,5,0,Math.PI*2); ctx.fill();
    }
    // Phase 2 shield
    if(this.phase>=2) {
      ctx.strokeStyle='rgba(255,100,50,0.6)'; ctx.lineWidth=3; ctx.shadowBlur=15; ctx.shadowColor='#FF6432';
      ctx.beginPath(); ctx.arc(this.x,this.y,this.w*0.9,this.shieldArc,this.shieldArc+Math.PI*1.5); ctx.stroke();
    }
    // HP bar
