/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: RENDER — STARS
   ═══════════════════════════════════════════════════════════════════════════ */
const STARS = Array.from({length:120}, () => ({
  x:rnd(0,W), y:rnd(0,H), spd:rnd(0.3,1.5), sz:rnd(0.5,2),
  bright:rnd(0.2,0.9)
}));

function drawStars() {
  STARS.forEach(s => {
    s.y += s.spd;
    if(s.y > H) { s.y=0; s.x=rnd(0,W); }
    ctx.fillStyle = `rgba(255,220,150,${s.bright})`;
    ctx.fillRect(s.x, s.y, s.sz, s.sz*2);
  });
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: RENDER — PARTICLES (Phase 3 swaps in Proton)
   ═══════════════════════════════════════════════════════════════════════════ */
class Particle {
  constructor(x,y,vx,vy,color,life,sz) {
    this.x=x; this.y=y; this.vx=vx; this.vy=vy;
    this.color=color; this.life=life; this.maxLife=life; this.sz=sz;
  }
  update(){ this.x+=this.vx; this.y+=this.vy; this.vy+=0.05; this.life--; }
  draw(ctx) {
    const a = this.life/this.maxLife;
    ctx.globalAlpha = a;
    ctx.fillStyle = this.color;
    ctx.beginPath(); ctx.arc(this.x,this.y,this.sz*a,0,Math.PI*2); ctx.fill();
    ctx.globalAlpha = 1;
  }
}

let particles = [];
function explode(x,y,color,count=20,speed=3) {
  const n = Config.get('reducedMotion') ? Math.ceil(count*0.5) : count;
  for(let i=0;i<n;i++) {
    const ang = rnd(0,Math.PI*2);
    const spd = rnd(0.5,speed);
    particles.push(new Particle(x,y,Math.cos(ang)*spd,Math.sin(ang)*spd,color,rnd(20,40),rnd(1,4)));
  }
}
function sparkle(x,y,color,count=8) {
  const n = Config.get('reducedMotion') ? Math.ceil(count*0.5) : count;
  for(let i=0;i<n;i++) {
    const ang = rnd(0,Math.PI*2);
    particles.push(new Particle(x,y,Math.cos(ang)*rnd(1,3),Math.sin(ang)*rnd(1,3),color,rnd(10,20),rnd(1,2)));
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: INPUT (Phase 5 adds gamepad + nipplejs touch)
   ═══════════════════════════════════════════════════════════════════════════ */
const keys = {};
window.addEventListener('keydown', e => { keys[e.code]=true; e.preventDefault(); });
window.addEventListener('keyup',   e => { keys[e.code]=false; });

// Touch input state
const touch = {
  p1: { dx:0, dy:0, fire:false, id:null, ox:0, oy:0 },
  p2: { dx:0, dy:0, fire:false, id:null, ox:0, oy:0 }
};

function getTouchPos(e) {
  const rect = canvas.getBoundingClientRect();
  const scaleX = W / rect.width;
  const scaleY = H / rect.height;
  return { x:(e.clientX-rect.left)*scaleX, y:(e.clientY-rect.top)*scaleY };
}

const mc = document.getElementById('mobile-controls');
mc.addEventListener('touchstart', e => {
  Array.from(e.changedTouches).forEach(t => {
    const pos = getTouchPos(t);
    const side = pos.x < W/2 ? 'p1' : 'p2';
    if(!touch[side].id) {
      touch[side].id = t.identifier;
      touch[side].ox = pos.x; touch[side].oy = pos.y;
      touch[side].dx=0; touch[side].dy=0; touch[side].fire=false;
    }
  });
},{passive:false});

mc.addEventListener('touchmove', e => {
  e.preventDefault();
  Array.from(e.changedTouches).forEach(t => {
    const pos = getTouchPos(t);
    ['p1','p2'].forEach(p => {
      if(touch[p].id === t.identifier) {
        touch[p].dx = clamp((pos.x - touch[p].ox)/40, -1, 1);
        touch[p].dy = clamp((pos.y - touch[p].oy)/40, -1, 1);
      }
    });
  });
},{passive:false});

['touchend','touchcancel'].forEach(ev => mc.addEventListener(ev, e => {
  Array.from(e.changedTouches).forEach(t => {
    ['p1','p2'].forEach(p => {
      if(touch[p].id === t.identifier) {
        touch[p].id=null; touch[p].dx=0; touch[p].dy=0;
      }
    });
  });
}));

// Fire buttons
document.getElementById('fire1-btn').addEventListener('touchstart', e => { touch.p1.fire=true; e.preventDefault(); });
document.getElementById('fire1-btn').addEventListener('touchend', e => { touch.p1.fire=false; });
document.getElementById('fire2-btn').addEventListener('touchstart', e => { touch.p2.fire=true; e.preventDefault(); });
document.getElementById('fire2-btn').addEventListener('touchend', e => { touch.p2.fire=false; });

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: ENTITIES — BULLET
   ═══════════════════════════════════════════════════════════════════════════ */
class Bullet {
  constructor(x,y,vx,vy,color,dmg,sz,isPlayer) {
    this.x=x; this.y=y; this.vx=vx; this.vy=vy;
    this.color=color; this.dmg=dmg; this.sz=sz; this.isPlayer=isPlayer; this.dead=false;
  }
  update() { this.x+=this.vx; this.y+=this.vy; if(this.y<-20||this.y>H+20||this.x<-20||this.x>W+20) this.dead=true; }
  draw(ctx) {
    ctx.save();
    ctx.shadowBlur=8; ctx.shadowColor=this.color;
    ctx.fillStyle=this.color;
    ctx.beginPath();
    ctx.ellipse(this.x, this.y, this.sz, this.sz*2.5, 0, 0, Math.PI*2);
    ctx.fill();
    ctx.restore();
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: ENTITIES — POWER-UP
   ═══════════════════════════════════════════════════════════════════════════ */
const PU_TYPES = ['SHOT','SPEED','SHIELD','BOMB'];
class PowerUp {
  constructor(x,y,type) {
    this.x=x; this.y=y; this.type=type; this.dead=false; this.t=0;
    this.colors = { SHOT:'#FF8800', SPEED:'#00FFFF', SHIELD:'#4488FF', BOMB:'#FF4466' };
  }
  update() { this.y += 1.2; this.t++; if(this.y>H+20) this.dead=true; }
  draw(ctx) {
    const c = this.colors[this.type];
    const pulse = Math.sin(this.t*0.15)*3;
    ctx.save();
    ctx.shadowBlur=14+pulse; ctx.shadowColor=c;
    ctx.strokeStyle=c; ctx.lineWidth=2;
    ctx.beginPath(); ctx.arc(this.x,this.y,12+pulse,0,Math.PI*2); ctx.stroke();
    ctx.fillStyle=c; ctx.font='bold 9px Share Tech Mono'; ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText(this.type[0], this.x, this.y);
    ctx.restore();
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: ENTITIES — PLAYER
   ═══════════════════════════════════════════════════════════════════════════ */
class Player {
  constructor(x,y,pid,color) {
    this.x=x; this.y=y; this.pid=pid; this.color=color;
    this.w=24; this.h=28; this.dead=false; this.invTime=0;
    this.shotLevel=1; this.speed=3.2; this.hasShield=false; this.shieldTime=0;
    this.bombs=3; this.fireTimer=0; this.fireRate=8;
    this.score=0; this.t=0; this.thrusterT=0;
    this.lives = DIFF_CFG[game.diff].lives;
    this.dying=0; this.respawnTimer=0; this.active=true;
  }
  getInput() {
    const spd = this.speed;
    let dx=0, dy=0, fire=false, bomb=false;
    if(this.pid===1) {
      if(keys['KeyA']||keys['ArrowLeft']) dx=-1;
      if(keys['KeyD']||keys['ArrowRight']) dx=1;
      if(keys['KeyW']||keys['ArrowUp']) dy=-1;
      if(keys['KeyS']||keys['ArrowDown']) dy=1;
      fire = keys['Space']||keys['KeyZ'];
      bomb = keys['KeyX'];
      // touch p1
      dx += touch.p1.dx; dy += touch.p1.dy;
      if(touch.p1.fire) fire=true;
    } else {
      if(keys['Numpad4']||keys['KeyJ']) dx=-1;
      if(keys['Numpad6']||keys['KeyL']) dx=1;
      if(keys['Numpad8']||keys['KeyI']) dy=-1;
      if(keys['Numpad5']||keys['KeyK']) dy=1;
      fire = keys['Enter']||keys['NumpadEnter']||keys['KeyM'];
      bomb = keys['KeyN'];
      dx += touch.p2.dx; dy += touch.p2.dy;
      if(touch.p2.fire) fire=true;
    }
    return {dx:clamp(dx,-1,1), dy:clamp(dy,-1,1), fire, bomb};
  }
  update(bullets) {
    this.t++;
    if(this.dying>0) { this.dying--; return; }
    if(this.respawnTimer>0) { this.respawnTimer--; if(this.respawnTimer===0) { this.invTime=120; } return; }
    if(this.invTime>0) this.invTime--;
    if(this.hasShield) { this.shieldTime--; if(this.shieldTime<=0) this.hasShield=false; }
    const inp = this.getInput();
    this.x = clamp(this.x + inp.dx*this.speed, this.w/2, W-this.w/2);
    this.y = clamp(this.y + inp.dy*this.speed, this.h/2, H-this.h/2);
    this.fireTimer++;
    if(inp.fire && this.fireTimer >= this.fireRate) {
      this.fireTimer=0; this.shoot(bullets);
    }
    if(inp.bomb && this.bombs>0) { this.useBomb(bullets); this.bombs=Math.max(0,this.bombs-1); }
    this.thrusterT++;
    // thruster particles
    if(this.t%3===0) sparkle(this.x, this.y+this.h/2, this.pid===1?'#FF8800':'#0088FF', 2);
  }
  shoot(bullets) {
    const spd = -9;
    const c = this.pid===1 ? '#FFE066' : '#66EEFF';
    if(this.shotLevel===1) {
      bullets.push(new Bullet(this.x, this.y-this.h/2, 0, spd, c, 1, 2.5, true));
      Audio.play('shoot');
    } else if(this.shotLevel===2) {
      bullets.push(new Bullet(this.x-7, this.y-this.h/2, 0, spd, c, 1, 2.5, true));
      bullets.push(new Bullet(this.x+7, this.y-this.h/2, 0, spd, c, 1, 2.5, true));
      Audio.play('shoot');
    } else if(this.shotLevel>=3) {
      bullets.push(new Bullet(this.x, this.y-this.h/2, 0, spd, c, 1.5, 2.5, true));
      bullets.push(new Bullet(this.x-10, this.y-this.h/2, -0.5, spd, c, 1, 2, true));
      bullets.push(new Bullet(this.x+10, this.y-this.h/2,  0.5, spd, c, 1, 2, true));
      Audio.play('shoot_powered');
    }
  }
  useBomb(bullets) {
    explode(this.x, this.y, this.color, 40, 5);
    // screen flash
    game.screenFlash = 10;
    Audio.play('bomb');
    Audio.duck(0.3, 600);
    // kill all enemy bullets
    game.bullets = game.bullets.filter(b => b.isPlayer);
    // damage all enemies
    game.enemies.forEach(e => { e.hp -= 5; if(e.hp<=0) e.hp=0; });
  }
  takeDamage() {
    if(this.invTime>0||this.hasShield||this.dying>0) return;
    this.lives--;
    this.invTime=0;
    this.dying=60;
    explode(this.x, this.y, this.color, 50, 4);
    Audio.play('hit_player');
    Audio.play('explode_big');
    Audio.duck(0.4, 500);
    if(this.lives<=0) {
      this.active=false;
      this.dead=true;
    } else {
      this.respawnTimer=90;
      this.x = this.pid===1 ? W*0.35 : W*0.65;
      this.y = H-80;
    }
  }
  draw(ctx) {
    if(this.dying>0) {
      const a = this.dying/60;
      ctx.globalAlpha = a;
    }
    if(this.respawnTimer>0) { ctx.globalAlpha=0; }
    if(this.invTime>0 && Math.floor(this.invTime/5)%2===0) { ctx.globalAlpha=0.3; }
    // Thruster flame
    if(this.dying===0 && this.respawnTimer===0) {
      const flameLen = 10+Math.sin(this.t*0.4)*5;
      const grad = ctx.createLinearGradient(this.x,this.y+this.h/2,this.x,this.y+this.h/2+flameLen);
      grad.addColorStop(0, this.pid===1?'#FFA000':'#0088FF');
      grad.addColorStop(1,'transparent');
      ctx.fillStyle=grad;
      ctx.beginPath(); ctx.ellipse(this.x,this.y+this.h/2+flameLen/2,5,flameLen/2,0,0,Math.PI*2); ctx.fill();
    }
    // Ship body
    ctx.save();
    ctx.shadowBlur=16; ctx.shadowColor=this.color;
    ctx.fillStyle=this.color;
    // Main body
    ctx.beginPath();
    ctx.moveTo(this.x, this.y-this.h/2);
    ctx.lineTo(this.x-this.w/2, this.y+this.h/2);
    ctx.lineTo(this.x-this.w/4, this.y+this.h/4);
    ctx.lineTo(this.x, this.y+this.h/3);
    ctx.lineTo(this.x+this.w/4, this.y+this.h/4);
    ctx.lineTo(this.x+this.w/2, this.y+this.h/2);
    ctx.closePath(); ctx.fill();
    // Cockpit
    ctx.fillStyle='#001133';
    ctx.beginPath(); ctx.ellipse(this.x, this.y-this.h/8, 5, 7, 0, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle='rgba(100,200,255,0.8)';
    ctx.beginPath(); ctx.ellipse(this.x, this.y-this.h/8, 3, 5, 0, 0, Math.PI*2); ctx.fill();
    // Shield
    if(this.hasShield) {
      ctx.strokeStyle='rgba(68,136,255,0.8)'; ctx.lineWidth=2; ctx.shadowBlur=20; ctx.shadowColor='#4488FF';
      ctx.beginPath(); ctx.arc(this.x,this.y,this.h*0.7,0,Math.PI*2); ctx.stroke();
    }
    ctx.restore();
    ctx.globalAlpha=1;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: ENTITIES — ENEMY
   ═══════════════════════════════════════════════════════════════════════════ */
class Enemy {
  constructor(x,y,type,diff) {
    this.x=x; this.y=y; this.type=type; this.diff=diff;
    this.dead=false; this.t=0; this.fireTimer=0;
    this.vx=0; this.vy=0;
    const dc = DIFF_CFG[diff];
    switch(type) {
      case 'basic':  this.w=22;this.h=20;this.hp=2; this.maxHp=2; this.pts=100; this.color='#FF6633'; this.vy=0.8*dc.enemySpd; break;
      case 'weaver': this.w=20;this.h=18;this.hp=3; this.maxHp=3; this.pts=150; this.color='#FF33AA'; this.vy=0.9*dc.enemySpd; break;
      case 'bomber': this.w=32;this.h=28;this.hp=6; this.maxHp=6; this.pts=300; this.color='#AA44FF'; this.vy=0.5*dc.enemySpd; break;
      case 'kamikaze':this.w=18;this.h=16;this.hp=1;this.maxHp=1;this.pts=200; this.color='#FFAA00'; this.vy=1.5*dc.enemySpd; break;
      case 'elite':  this.w=26;this.h=24;this.hp=8; this.maxHp=8; this.pts=400; this.color='#00FFAA'; this.vy=1.0*dc.enemySpd; break;
    }
    this.fireRate = Math.max(40, 100/dc.fireRate);
    this.initX=x; this.initY=y;
  }
  update(bullets, players) {
    this.t++;
    this.fireTimer++;
    const dc = DIFF_CFG[this.diff];
    switch(this.type) {
      case 'basic': this.y+=this.vy; break;
      case 'weaver': this.x=this.initX+Math.sin(this.t*0.04)*80; this.y+=this.vy; break;
      case 'bomber': this.y+=this.vy; break;
      case 'kamikaze': {
        const tgt = this.getNearestPlayer(players);
        if(tgt) {
          const dx=tgt.x-this.x, dy=tgt.y-this.y, d=Math.hypot(dx,dy)||1;
          this.x+=dx/d*this.vy*1.8; this.y+=dy/d*this.vy*1.8;
        } else { this.y+=this.vy; }
        break;
      }
      case 'elite': this.x=this.initX+Math.sin(this.t*0.06)*60; this.y+=this.vy; break;
    }
    if(this.y > H+50) this.dead=true;
    // Shooting
    if(this.type!=='kamikaze' && this.fireTimer>=this.fireRate) {
      this.fireTimer=0; this.shoot(bullets, players);
    }
  }
  getNearestPlayer(players) {
    const alive = players.filter(p=>p.active&&!p.dying&&p.respawnTimer===0);
    if(!alive.length) return null;
    return alive.reduce((a,b)=>dist(this,a)<dist(this,b)?a:b);
  }
  shoot(bullets, players) {
    const tgt = this.getNearestPlayer(players);
    const c = '#FF3333';
    if(this.type==='bomber') {
      for(let i=-2;i<=2;i++) bullets.push(new Bullet(this.x,this.y+this.h/2,i*0.8,3,c,1,3,false));
    } else if(this.type==='elite') {
      const dx=tgt?(tgt.x-this.x):0, dy=tgt?(tgt.y-this.y):1, d=Math.hypot(dx,dy)||1;
      bullets.push(new Bullet(this.x,this.y+this.h/2,dx/d*3,dy/d*3,c,1,2.5,false));
      bullets.push(new Bullet(this.x,this.y+this.h/2,-dx/d*3+1.5,dy/d*3,c,1,2.5,false));
    } else if(tgt) {
      const dx=tgt.x-this.x, dy=tgt.y-this.y, d=Math.hypot(dx,dy)||1;
      bullets.push(new Bullet(this.x,this.y+this.h/2,dx/d*3,dy/d*3,c,1,2,false));
    }
  }
  takeDamage(dmg) {
    this.hp -= dmg;
    sparkle(this.x,this.y,this.color,4);
    Audio.play('hit_enemy');
    if(this.hp<=0) {
      this.dead=true;
      explode(this.x,this.y,this.color,30,3);
      Audio.play('explode_small');
      return true;
    }
    return false;
  }
  draw(ctx) {
    ctx.save();
    ctx.shadowBlur=10; ctx.shadowColor=this.color;
    ctx.fillStyle=this.color;
    switch(this.type) {
      case 'basic': {
        ctx.beginPath();
        ctx.moveTo(this.x,this.y+this.h/2);
        ctx.lineTo(this.x-this.w/2,this.y-this.h/2);
        ctx.lineTo(this.x+this.w/2,this.y-this.h/2);
        ctx.closePath(); ctx.fill(); break;
      }
      case 'weaver': {
        ctx.beginPath();
        ctx.moveTo(this.x,this.y+this.h/2);
        ctx.lineTo(this.x-this.w/2,this.y-this.h/4);
        ctx.lineTo(this.x-this.w/4,this.y-this.h/2);
        ctx.lineTo(this.x+this.w/4,this.y-this.h/2);
        ctx.lineTo(this.x+this.w/2,this.y-this.h/4);
        ctx.closePath(); ctx.fill(); break;
      }
      case 'bomber': {
        ctx.beginPath();
        ctx.ellipse(this.x,this.y,this.w/2,this.h/2,0,0,Math.PI*2); ctx.fill();
        ctx.fillStyle='#660044';
        ctx.beginPath(); ctx.ellipse(this.x,this.y,this.w/4,this.h/3,0,0,Math.PI*2); ctx.fill(); break;
      }
      case 'kamikaze': {
        ctx.beginPath();
        ctx.moveTo(this.x,this.y+this.h/2);
        ctx.lineTo(this.x-this.w/3,this.y-this.h/2);
        ctx.lineTo(this.x,this.y-this.h/4);
        ctx.lineTo(this.x+this.w/3,this.y-this.h/2);
        ctx.closePath(); ctx.fill(); break;
      }
      case 'elite': {
        const s = this.t*0.03;
        ctx.beginPath();
        for(let i=0;i<6;i++){
          const a=i*Math.PI/3+s;
          ctx[i===0?'moveTo':'lineTo'](this.x+Math.cos(a)*this.w/2,this.y+Math.sin(a)*this.h/2);
        }
        ctx.closePath(); ctx.fill(); break;
      }
    }
    // HP bar
    if(this.hp<this.maxHp && this.hp>0) {
      const bw=this.w; const pct=this.hp/this.maxHp;
      ctx.fillStyle='#333'; ctx.fillRect(this.x-bw/2,this.y-this.h/2-8,bw,4);
      ctx.fillStyle=pct>0.5?'#44FF44':pct>0.25?'#FFAA00':'#FF4444';
      ctx.fillRect(this.x-bw/2,this.y-this.h/2-8,bw*pct,4);
    }
    ctx.restore();
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: ENTITIES — BOSS
   ═══════════════════════════════════════════════════════════════════════════ */
class Boss {
  constructor(level, diff) {
    this.x=W/2; this.y=-80; this.targetY=110; this.diff=diff;
    this.w=80; this.h=60; this.t=0; this.dead=false; this.phase=0;
    const dc=DIFF_CFG[diff];
    const base = [500,800,1200,1600,2200,3000][level-1]||1000;
    this.maxHp = Math.floor(base*dc.bossHp);
    this.hp=this.maxHp;
    this.pts=base*10;
    this.fireTimer=0;
    this.fireRate=Math.max(20,60/dc.fireRate);
    this.colors=['#FF4466','#AA00FF','#FF8800','#00FFAA','#FF2200','#FFFFFF'];
    this.color=this.colors[level-1]||'#FF4466';
    this.vx=1.2*dc.enemySpd; this.vy=0;
    this.entering=true;
    this.armAngle=0; this.shieldArc=0;
  }
  update(bullets, players) {
    this.t++;
    this.armAngle += 0.04;
    if(this.entering) { this.y=lerp(this.y,this.targetY,0.02); if(Math.abs(this.y-this.targetY)<1){this.y=this.targetY;this.entering=false;} return; }
    // Phase transitions
    const hpPct = this.hp/this.maxHp;
    if(hpPct<0.5&&this.phase===0) this.phase=1;
    if(hpPct<0.25&&this.phase===1) this.phase=2;
    // Movement
    this.x += this.vx;
    if(this.x>W-this.w/2||this.x<this.w/2) this.vx*=-1;
    if(this.phase>=1) { this.y=this.targetY+Math.sin(this.t*0.02)*40; }
    this.fireTimer++;
    const rate = this.phase===2?this.fireRate*0.5:this.fireRate;
    if(this.fireTimer>=rate) { this.fireTimer=0; this.shoot(bullets,players); }
    // Shield arc rotation for phase 2
    if(this.phase>=2) this.shieldArc += 0.06;
  }
  shoot(bullets, players) {
    const tgt = players.filter(p=>p.active&&!p.dying&&p.respawnTimer===0);
    const c='#FF2222';
    if(this.phase===0) {
      // aimed shots
      tgt.forEach(t=>{ const dx=t.x-this.x,dy=t.y-this.y,d=Math.hypot(dx,dy)||1;
        bullets.push(new Bullet(this.x,this.y+this.h/2,dx/d*4,dy/d*4,c,1,3,false)); });
    } else if(this.phase===1) {
      // spread
      for(let i=-3;i<=3;i++) bullets.push(new Bullet(this.x,this.y+this.h/2,i*1.2,4,c,1,3,false));
      if(tgt[0]){ const dx=tgt[0].x-this.x,dy=tgt[0].y-this.y,d=Math.hypot(dx,dy)||1;
        bullets.push(new Bullet(this.x,this.y+this.h/2,dx/d*5,dy/d*5,'#FF8800',2,4,false));}
    } else {
      // radial burst
      for(let i=0;i<12;i++){const a=i*Math.PI/6+this.t*0.01;
        bullets.push(new Bullet(this.x,this.y,Math.cos(a)*4,Math.sin(a)*4,'#FF0044',1,3,false));}
      tgt.forEach(t=>{ const dx=t.x-this.x,dy=t.y-this.y,d=Math.hypot(dx,dy)||1;
        bullets.push(new Bullet(this.x,this.y,dx/d*6,dy/d*6,'#FF8800',2,5,false)); });
    }
  }
  takeDamage(dmg) {
    if(this.entering) return false;
    this.hp-=dmg; sparkle(this.x,this.y,this.color,3);
    Audio.play('hit_enemy');
    if(this.hp<=0){
      this.dead=true;
      explode(this.x,this.y,this.color,80,5);
      Audio.play('explode_big');
      Audio.duck(0.3, 700);
      return true;
    }
    return false;
  }
  draw(ctx) {
    ctx.save();
    ctx.shadowBlur=20; ctx.shadowColor=this.color;
    // Main hull
    ctx.fillStyle=this.color;
    ctx.beginPath();
    ctx.moveTo(this.x,this.y-this.h/2);
    ctx.lineTo(this.x-this.w/2,this.y-this.h/4);
    ctx.lineTo(this.x-this.w/2,this.y+this.h/3);
    ctx.lineTo(this.x-this.w/4,this.y+this.h/2);
    ctx.lineTo(this.x+this.w/4,this.y+this.h/2);
    ctx.lineTo(this.x+this.w/2,this.y+this.h/3);
    ctx.lineTo(this.x+this.w/2,this.y-this.h/4);
    ctx.closePath(); ctx.fill();
    // Core
    ctx.fillStyle='rgba(0,0,0,0.6)';
    ctx.beginPath(); ctx.ellipse(this.x,this.y,this.w/4,this.h/4,0,0,Math.PI*2); ctx.fill();
    ctx.shadowBlur=30; ctx.shadowColor='#FFFFFF';
    ctx.strokeStyle='rgba(255,255,255,0.9)'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.ellipse(this.x,this.y,this.w/5,this.h/5,0,0,Math.PI*2); ctx.stroke();
    // Arms
    for(let i=0;i<4;i++){
      const a=this.armAngle+i*Math.PI/2;
      ctx.strokeStyle=this.color; ctx.lineWidth=4; ctx.shadowBlur=15;
      ctx.beginPath(); ctx.moveTo(this.x,this.y);
      ctx.lineTo(this.x+Math.cos(a)*this.w*0.7,this.y+Math.sin(a)*this.h*0.7); ctx.stroke();
      ctx.fillStyle=this.color;
      ctx.beginPath(); ctx.arc(this.x+Math.cos(a)*this.w*0.7,this.y+Math.sin(a)*this.h*0.7,5,0,Math.PI*2); ctx.fill();
    }
    // Phase 2 shield
    if(this.phase>=2) {
      ctx.strokeStyle='rgba(255,100,50,0.6)'; ctx.lineWidth=3; ctx.shadowBlur=15; ctx.shadowColor='#FF6432';
      ctx.beginPath(); ctx.arc(this.x,this.y,this.w*0.9,this.shieldArc,this.shieldArc+Math.PI*1.5); ctx.stroke();
    }
    // HP bar
    const bw=W*0.5; const pct=this.hp/this.maxHp;
    ctx.shadowBlur=0;
    ctx.fillStyle='rgba(0,0,0,0.7)'; ctx.fillRect(W/2-bw/2,10,bw,12);
    ctx.fillStyle=pct>0.5?'#FF4466':pct>0.25?'#FF8800':'#FF2200';
    ctx.fillRect(W/2-bw/2,10,bw*pct,12);
    ctx.strokeStyle='rgba(255,255,255,0.3)'; ctx.lineWidth=1; ctx.strokeRect(W/2-bw/2,10,bw,12);
    ctx.fillStyle='#FFF'; ctx.font='8px Share Tech Mono'; ctx.textAlign='center';
    ctx.fillText('BOSS HP',W/2,20);
    ctx.restore();
  }
}

