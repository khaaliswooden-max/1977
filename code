        ctx.fillText(valText, W - 32, y);
      } else if (it.type === 'bool') {
        valText = val ? '◄ ON ►' : '◄ OFF ►';
        ctx.fillStyle = val ? '#44FF88' : '#888888';
        ctx.fillText(valText, W - 32, y);
      }
    }
  });
  ctx.globalAlpha = 1;
  ctx.fillStyle = 'rgba(255,255,255,0.4)'; ctx.font = '9px Share Tech Mono'; ctx.textAlign = 'center';
  ctx.fillText('W/S UP/DOWN · A/D or ←/→ CHANGE · ESC BACK', W/2, H - 24);
  ctx.restore();
}

// ── High Scores ────────────────────────────────────────────────────────────
const MAX_HIGH_SCORES = 10;
function getHighScores() {
  const all = Config.get('highScores') || [];
  return Array.isArray(all) ? all : [];
}
function topScoresForDiff(diff) {
  return getHighScores()
    .filter(s => s.diff === diff)
    .sort((a,b) => b.score - a.score)
    .slice(0, MAX_HIGH_SCORES);
}
function isHighScore(score, diff) {
  const list = topScoresForDiff(diff);
  return list.length < MAX_HIGH_SCORES || score > list[list.length - 1].score;
}
function addHighScore(entry) {
  const all = getHighScores().concat([entry]);
  Config.set('highScores', all.slice(-200)); // cap storage
}
function queueHighScoreIfQualifies() {
  const score = game.totalScore | 0;
  if (score <= 0) return;
  if (!isHighScore(score, game.diff)) return;
  game.pendingScore = { score, diff: game.diff, mode: game.mode };
  game.nameEntryChars = ['A','A','A'];
  game.nameEntryCursor = 0;
  // Defer the state change so the game-over SFX/visuals land first. Only
  // transition if the player hasn't already left the game-over screen.
  setTimeout(() => {
    if (game.pendingScore && (game.state === GS.GAMEOVER || game.state === GS.VICTORY)) {
      game.state = GS.NAME_ENTRY;
    } else {
      game.pendingScore = null;
    }
  }, 1200);
}
function drawHighScores() {
  drawStars();
  ctx.save();
  ctx.shadowBlur = 18; ctx.shadowColor = '#FFAA88';
  ctx.fillStyle = '#FFAA88'; ctx.font = '22px Orbitron'; ctx.textAlign = 'center';
  ctx.fillText('HIGH SCORES', W/2, 60);
  ctx.shadowBlur = 0;
  // Difficulty tabs
  DIFF_CFG.forEach((d, i) => {
    const x = W/4 * (i+1);
    const sel = game.scoresTab === i;
    ctx.globalAlpha = sel ? 1 : 0.55;
    ctx.fillStyle = sel ? d.color : 'rgba(255,255,255,0.5)';
    ctx.font = '11px Orbitron';
    ctx.fillText(d.name, x, 95);
    if (sel) {
      ctx.fillRect(x - 40, 100, 80, 2);
    }
  });
  ctx.globalAlpha = 1;
  // List
  const scores = topScoresForDiff(game.scoresTab);
  ctx.textAlign = 'left'; ctx.font = '12px Share Tech Mono';
  if (scores.length === 0) {
    ctx.fillStyle = 'rgba(255,255,255,0.5)'; ctx.textAlign = 'center';
    ctx.fillText('— NO SCORES YET —', W/2, 200);
    ctx.fillText('BE THE FIRST.',     W/2, 220);
  } else {
    const top = 140;
    scores.forEach((s, i) => {
      const y = top + i * 22;
      ctx.fillStyle = i === 0 ? '#FFB800' : i < 3 ? '#FFEEBB' : 'rgba(255,255,255,0.75)';
      ctx.textAlign = 'left';
      ctx.fillText(String(i+1).padStart(2,' ') + '.', 40, y);
      ctx.fillText(s.initials || '---', 76, y);
      ctx.textAlign = 'right';
      ctx.fillText(String(s.score).padStart(8,'0'), W - 80, y);
      ctx.fillText((s.mode === 2 ? '2P' : '1P'), W - 40, y);
    });
  }
  ctx.fillStyle = 'rgba(255,255,255,0.4)'; ctx.font = '9px Share Tech Mono'; ctx.textAlign = 'center';
  ctx.fillText('A/D or ←/→ SWITCH DIFFICULTY · ESC BACK', W/2, H - 24);
  ctx.restore();
}

// ── Name Entry (3 initials on new high score) ─────────────────────────────
const ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-_';
function handleNameEntryInput(up, dn, lf, rt, ok) {
  if (lf) { game.nameEntryCursor = (game.nameEntryCursor + 2) % 3; Audio.play('menu_move'); return; }
  if (rt) { game.nameEntryCursor = (game.nameEntryCursor + 1) % 3; Audio.play('menu_move'); return; }
  const curChar = game.nameEntryChars[game.nameEntryCursor];
  const i = ALPHABET.indexOf(curChar);
  if (up) { game.nameEntryChars[game.nameEntryCursor] = ALPHABET[(i + ALPHABET.length - 1) % ALPHABET.length]; Audio.play('menu_move'); return; }
  if (dn) { game.nameEntryChars[game.nameEntryCursor] = ALPHABET[(i + 1) % ALPHABET.length]; Audio.play('menu_move'); return; }
  if (ok) {
    if (game.nameEntryCursor < 2) {
      game.nameEntryCursor++;
      Audio.play('menu_move');
    } else {
      Audio.play('menu_confirm');
      const initials = game.nameEntryChars.join('');
      const p = game.pendingScore;
      addHighScore({ initials, score: p.score, diff: p.diff, mode: p.mode, date: Date.now() });
      game.pendingScore = null;
      game.state = GS.HIGHSCORES;
      game.scoresTab = p.diff;
      Toasts.push('SCORE SAVED: ' + initials, '#FFEEBB');
    }
  }
}
function drawNameEntry() {
  drawStars();
  ctx.save();
  ctx.shadowBlur = 24; ctx.shadowColor = '#FFB800';
  ctx.fillStyle = '#FFB800'; ctx.font = '22px Orbitron'; ctx.textAlign = 'center';
  ctx.fillText('NEW HIGH SCORE', W/2, 140);
  ctx.shadowBlur = 10;
  ctx.fillStyle = '#FFEEBB'; ctx.font = '14px Orbitron';
  const sc = game.pendingScore ? game.pendingScore.score : 0;
  ctx.fillText(String(sc).padStart(8,'0'), W/2, 175);
  ctx.fillText('ENTER YOUR INITIALS', W/2, 230);
  // 3 character slots
  const slotW = 50, gap = 14;
  const totalW = 3 * slotW + 2 * gap;
  const startX = W/2 - totalW/2;
  for (let i = 0; i < 3; i++) {
    const x = startX + i * (slotW + gap);
    const y = 260;
    const sel = game.nameEntryCursor === i;
    ctx.strokeStyle = sel ? '#FFEEBB' : 'rgba(255,255,255,0.3)';
    ctx.lineWidth = sel ? 2 : 1;
    ctx.strokeRect(x, y, slotW, slotW);
    ctx.shadowBlur = sel ? 18 : 0;
    ctx.shadowColor = '#FFB800';
    ctx.fillStyle = sel ? '#FFB800' : 'rgba(255,200,120,0.85)';
    ctx.font = '32px Orbitron'; ctx.textAlign = 'center';
    ctx.fillText(game.nameEntryChars[i], x + slotW/2, y + slotW*0.7);
    if (sel) {
      ctx.fillStyle = '#FFEEBB'; ctx.font = '10px Orbitron';
      ctx.fillText('▲', x + slotW/2, y - 6);
      ctx.fillText('▼', x + slotW/2, y + slotW + 14);
    }
  }
  ctx.shadowBlur = 0;
  ctx.fillStyle = 'rgba(255,255,255,0.5)'; ctx.font = '9px Share Tech Mono';
  ctx.fillText('W/S CHANGE · A/D NEXT · ENTER CONFIRM', W/2, H - 60);
  ctx.restore();
}

function drawLevelClear() {
  drawStars();
  ctx.save();
  const dc=DIFF_CFG[game.diff];
  ctx.shadowBlur=20; ctx.shadowColor=dc.color;
  ctx.fillStyle=dc.color; ctx.font='28px Orbitron'; ctx.textAlign='center';
  ctx.fillText('LEVEL '+game.level+' CLEAR!', W/2, H/2-60);
  ctx.shadowBlur=10; ctx.fillStyle='#FFF'; ctx.font='14px Orbitron';
  ctx.fillText('SCORE: '+game.totalScore.toString().padStart(8,'0'), W/2, H/2);
  if(game.level<game.maxLevel) {
    const blink=Math.floor(game.levelClearTimer/20)%2;
    if(blink) { ctx.fillStyle=dc.color; ctx.font='12px Orbitron'; ctx.fillText('NEXT LEVEL INCOMING...', W/2, H/2+50); }
  }
  ctx.restore();
}

function drawGameOver(victory) {
  drawStars();
  ctx.save();
  const c=victory?'#FFB800':'#FF4444';
  ctx.shadowBlur=30; ctx.shadowColor=c;
  ctx.fillStyle=c; ctx.font='bold 34px Orbitron'; ctx.textAlign='center';
  ctx.fillText(victory?'VICTORY!':'GAME OVER', W/2, H/2-80);
  ctx.shadowBlur=10; ctx.fillStyle='#FFF'; ctx.font='14px Orbitron';
  ctx.fillText('FINAL SCORE', W/2, H/2-20);
  ctx.fillStyle=c; ctx.font='22px Orbitron';
  ctx.fillText(game.totalScore.toString().padStart(8,'0'), W/2, H/2+20);
  if(game.players.length>1) {
    ctx.fillStyle='#FFB800'; ctx.font='10px Orbitron';
    ctx.fillText('P1: '+String(game.players[0].score).padStart(7,'0'), W/2-60, H/2+50);
    ctx.fillText('P2: '+String(game.players[1].score).padStart(7,'0'), W/2+60, H/2+50);
  }
  const blink=Math.floor(menuT/25)%2;
  if(blink){ctx.fillStyle='rgba(255,255,255,0.7)';ctx.font='11px Orbitron';ctx.fillText(game.isMobile?'TAP TO PLAY AGAIN':'PRESS ENTER TO PLAY AGAIN',W/2,H/2+90);}
  ctx.restore();
}

function drawPaused() {
  ctx.fillStyle='rgba(0,0,0,0.5)';ctx.fillRect(0,0,W,H);
  ctx.save(); ctx.shadowBlur=20; ctx.shadowColor='#FFB800';
  ctx.fillStyle='#FFB800'; ctx.font='28px Orbitron'; ctx.textAlign='center';
  ctx.fillText('PAUSED',W/2,H/2);
  ctx.fillStyle='rgba(255,255,255,0.5)'; ctx.font='10px Orbitron';
  ctx.fillText(game.isMobile?'TAP TO RESUME':'ESC TO RESUME',W/2,H/2+40);
  ctx.restore();
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: INPUT — MENU PROCESSING
   ═══════════════════════════════════════════════════════════════════════════ */
const justPressed = {};
function checkJustPressed(code) {
  if(keys[code]&&!justPressed[code]) { justPressed[code]=true; return true; }
  if(!keys[code]) justPressed[code]=false;
  return false;
}

let tapFlag=false;
canvas.addEventListener('click', ()=>{ tapFlag=true; });
canvas.addEventListener('touchend', ()=>{ tapFlag=true; });

function handleMenuInput() {
  const up = checkJustPressed('KeyW')||checkJustPressed('ArrowUp');
  const dn = checkJustPressed('KeyS')||checkJustPressed('ArrowDown');
  const lf = checkJustPressed('KeyA')||checkJustPressed('ArrowLeft');
  const rt = checkJustPressed('KeyD')||checkJustPressed('ArrowRight');
  const ok = checkJustPressed('Space')||checkJustPressed('Enter')||tapFlag;
  const back = checkJustPressed('Escape');
  tapFlag=false;
  if(game.state===GS.MENU) {
    if(up) { game.menuSel=Math.max(0,game.menuSel-1); Audio.play('menu_move'); }
    if(dn) { game.menuSel=Math.min(MENU_ITEMS.length-1,game.menuSel+1); Audio.play('menu_move'); }
    if(ok) {
      const it = MENU_ITEMS[game.menuSel];
      Audio.play('menu_confirm');
      if (it.kind === 'diff')      { game.diff = it.diff; game.state = GS.MODE; game.modeSel = 0; }
      else if (it.target === 'OPTIONS')    { game.state = GS.OPTIONS;    game.optionsSel = 0; }
      else if (it.target === 'HIGHSCORES') { game.state = GS.HIGHSCORES; game.scoresTab = game.diff; }
    }
  } else if(game.state===GS.MODE) {
    if(up) { game.modeSel=0; Audio.play('menu_move'); }
    if(dn) { game.modeSel=1; Audio.play('menu_move'); }
    if(back) { game.state = GS.MENU; Audio.play('menu_move'); }
    if(ok) {
      game.mode=game.modeSel+1; game.level=1; initGame(); game.state=GS.PLAYING;
      document.getElementById('mobile-controls').style.display = game.isMobile||true?'block':'none';
      Audio.play('menu_confirm');
      Audio.playMusic(MUSIC_STAGE);
    }
  } else if(game.state===GS.OPTIONS) {
    handleOptionsInput(up, dn, lf, rt, ok, back);
  } else if(game.state===GS.HIGHSCORES) {
    if(lf) { game.scoresTab = (game.scoresTab + 2) % 3; Audio.play('menu_move'); }
    if(rt) { game.scoresTab = (game.scoresTab + 1) % 3; Audio.play('menu_move'); }
    if(ok || back) { game.state = GS.MENU; Audio.play('menu_move'); }
  } else if(game.state===GS.NAME_ENTRY) {
    handleNameEntryInput(up, dn, lf, rt, ok);
  } else if(game.state===GS.GAMEOVER||game.state===GS.VICTORY) {
    if(ok) {
      game.pendingScore = null;
      game.state=GS.MENU; Audio.play('menu_confirm'); Audio.playMusic(MUSIC_MENU);
    }
  } else if(game.state===GS.PAUSED) {
    if(back||ok) { game.state=GS.PLAYING; Audio.play('menu_confirm'); }
  } else if(game.state===GS.PLAYING) {
    if(back) { game.state=GS.PAUSED; Audio.play('menu_move'); }
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: ENGINE — UPDATE
   ═══════════════════════════════════════════════════════════════════════════ */
function update() {
  handleMenuInput();
  Toasts.update();
  // Slow-motion: stochastically skip physics ticks so time dilates smoothly.
  const ts = Camera.timeScale();
  if (game.state === GS.PLAYING && ts < 1 && Math.random() > ts) return;
  if(game.state===GS.LEVEL_CLEAR) {
    game.levelClearTimer++;
    if(game.levelClearTimer>160) {
      game.level++;
      if(game.level>game.maxLevel) {
        game.state=GS.VICTORY; Audio.stopMusic(); Audio.play('powerup');
        queueHighScoreIfQualifies();
      }
      else {
        game.enemies=[]; game.bullets=[]; game.powerups=[];
        game.boss=null; game.bossActive=false;
        game.waves=getLevelWaves(game.diff,game.level);
        game.currentWave=0; game.waveSpawnTimer=0;
        game.spawnedEnemies=[...game.waves[0]];
        game.state=GS.PLAYING;
        showFlash('LEVEL '+game.level);
        Audio.playMusic(MUSIC_STAGE);
        // Refill shield on novice between levels
        if(DIFF_CFG[game.diff].shield) game.players.forEach(p=>{ if(p.active){p.hasShield=true;p.shieldTime=600;} });
      }
    }
  }
  if(game.state!==GS.PLAYING) return;
  // Spawn enemies
  game.waveSpawnTimer++;
  if(game.spawnedEnemies.length>0 && game.waveSpawnTimer%30===0) spawnEnemy();
  // Check wave clear
  if(game.spawnedEnemies.length===0 && game.enemies.filter(e=>!e.dead).length===0) {
    if(game.bossActive && game.boss && !game.boss.dead) { /* boss still alive */ }
    else if(game.boss && game.boss.dead) {
      // Level clear!
      game.state=GS.LEVEL_CLEAR; game.levelClearTimer=0;
      explode(W/2,H/2,'#FFB800',80,6);
      Confetti.burst(W/2, H-80, ['#FFB800','#FF4466','#44FF88','#44AAFF'], 80);
    } else if(!game.bossActive) {
      startNextWave();
    }
  }
  // Update entities
  game.enemies.forEach(e => e.update(game.bullets, game.players));
  game.enemies = game.enemies.filter(e=>!e.dead);
  if(game.boss) { game.boss.update(game.bullets,game.players); if(game.boss.dead&&!game.bossActive) {} }
  game.bullets.forEach(b=>b.update());
  game.bullets = game.bullets.filter(b=>!b.dead);
  game.powerups.forEach(pu=>pu.update());
  game.powerups = game.powerups.filter(pu=>!pu.dead);
  particles.forEach(p=>p.update());
  particles = particles.filter(p=>p.life>0);
  Confetti.update();
  // Players
  game.players.forEach(p => { if(p.active||p.dying>0||p.respawnTimer>0) p.update(game.bullets); });
  // Check collisions
  checkCollisions();
  // Game over check
  const anyAlive = game.players.some(p=>p.active||p.dying>0||p.respawnTimer>0);
  if(!anyAlive) {
    game.state=GS.GAMEOVER; menuT=0;
    Audio.play('explode_big');
    Audio.stopMusic();
    queueHighScoreIfQualifies();
  }
  // Flash
  if(game.flashTimer>0) game.flashTimer--;
  if(game.screenFlash>0) game.screenFlash--;
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: ENGINE — DRAW
   ═══════════════════════════════════════════════════════════════════════════ */
function draw() {
  const now = performance.now();
  ctx.save();
  Camera.preRender(ctx, now);
  ctx.fillStyle='#000005'; ctx.fillRect(0,0,W,H);
  drawStars();
  if(game.state===GS.MENU)       { drawMenu();       ctx.restore(); Camera.postRender(ctx, now); CRT.draw(canvas, now); return; }
  if(game.state===GS.MODE)       { drawModeSelect(); ctx.restore(); Camera.postRender(ctx, now); CRT.draw(canvas, now); return; }
  if(game.state===GS.OPTIONS)    { drawOptions();    ctx.restore(); Camera.postRender(ctx, now); CRT.draw(canvas, now); return; }
  if(game.state===GS.HIGHSCORES) { drawHighScores(); ctx.restore(); Camera.postRender(ctx, now); CRT.draw(canvas, now); return; }
  if(game.state===GS.NAME_ENTRY) { drawNameEntry();  ctx.restore(); Camera.postRender(ctx, now); CRT.draw(canvas, now); return; }
  // Playing / paused / level clear
  particles.forEach(p=>p.draw(ctx));
  game.powerups.forEach(pu=>pu.draw(ctx));
  game.enemies.forEach(e=>e.draw(ctx));
  if(game.boss&&!game.boss.dead) game.boss.draw(ctx);
  game.bullets.forEach(b=>b.draw(ctx));
  game.players.forEach(p=>{ if(p.active||p.dying>0||p.respawnTimer>0) p.draw(ctx); });
  Confetti.draw(ctx);
  // HUD
  drawHUD();
  // Screen flash (legacy — Camera.flash now handles most cases)
  if(game.screenFlash>0) {
    ctx.fillStyle=`rgba(255,200,100,${game.screenFlash/15*0.4})`;
    ctx.fillRect(0,0,W,H);
  }
  // Damage vignette on invulnerability frames + low-life pulse.
  const anyHit = game.players.some(p => p.invTime > 0 && p.invTime < 90);
  const anyLow = game.players.some(p => p.active && p.lives <= 1);
  if (anyHit || anyLow) {
    const pulse = anyLow ? (0.18 + Math.sin(performance.now()/120) * 0.08) : 0;
    const hitA  = anyHit ? 0.38 : 0;
    const grad = ctx.createRadialGradient(W/2,H/2,H*0.25,W/2,H/2,H*0.65);
    grad.addColorStop(0,'rgba(255,0,32,0)');
    grad.addColorStop(1,`rgba(255,0,32,${Math.max(hitA, pulse)})`);
    ctx.fillStyle = grad;
    ctx.fillRect(0,0,W,H);
  }
  // Toasts (replaces the single flash message for stacked UX feedback)
  Toasts.draw(ctx);
  if(game.state===GS.LEVEL_CLEAR) drawLevelClear();
  if(game.state===GS.GAMEOVER) { menuT++; drawGameOver(false); }
  if(game.state===GS.VICTORY) { menuT++; drawGameOver(true); }
  if(game.state===GS.PAUSED) drawPaused();
  ctx.restore();
  Camera.postRender(ctx, now);
  CRT.draw(canvas, now);
}

/* ═══════════════════════════════════════════════════════════════════════════
   SECTION: ENGINE — MAIN LOOP
   ═══════════════════════════════════════════════════════════════════════════ */
function loop() {
  update(); draw();
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);

// Show mobile controls always (they're nearly invisible until touch)
document.getElementById('mobile-controls').style.display = 'block';

// Apply persisted config to DOM overlays on boot.
applyConfig();

// Register audio gesture listeners and start menu music on first interaction.
Audio.resumeOnGesture();
const bootMusic = () => {
  Audio.ensure();
  Audio.playMusic(MUSIC_MENU);
  window.removeEventListener('pointerdown', bootMusic);
  window.removeEventListener('keydown',     bootMusic);
  window.removeEventListener('touchstart',  bootMusic);
};
window.addEventListener('pointerdown', bootMusic, { once: true });
window.addEventListener('keydown',     bootMusic, { once: true });
window.addEventListener('touchstart',  bootMusic, { once: true });

console.log('[1977] build', BUILD_VERSION);
</script>
