// Returns wave config for given difficulty (0-2) and level (1-6)
function getLevelWaves(diff, level) {
  const d = DIFF_CFG[diff];
  const baseCount = [4,6,8,10,12,16][level-1];
  const waves = [];
  // Wave 1: basic enemies
  const w1 = [];
  for(let i=0;i<baseCount;i++) w1.push({type:'basic', x:rnd(40,W-40), y:rnd(-200,-50+i*(-30))});
  waves.push(w1);
  // Wave 2: weavers
  if(level>=2) {
    const w2=[]; const cnt=Math.floor(baseCount*0.7);
    for(let i=0;i<cnt;i++) w2.push({type:'weaver',x:rnd(40,W-40),y:rnd(-200,-50+i*(-30))});
    waves.push(w2);
  }
  // Wave 3: mixed
  if(level>=3) {
    const w3=[];
    for(let i=0;i<Math.floor(baseCount/2);i++) w3.push({type:'basic',x:rnd(40,W-40),y:-100-i*40});
    for(let i=0;i<3;i++) w3.push({type:'kamikaze',x:rnd(60,W-60),y:-200-i*60});
    waves.push(w3);
  }
  // Wave 4: bombers + elites
  if(level>=4) {
    const w4=[];
    for(let i=0;i<3;i++) w4.push({type:'bomber',x:80+i*120,y:-100-i*50});
    if(diff>=1) for(let i=0;i<4;i++) w4.push({type:'weaver',x:rnd(40,W-40),y:-250-i*40});
    waves.push(w4);
  }
  // Wave 5: elites
  if(level>=5) {
    const w5=[];
    const cnt=Math.floor(baseCount*0.5);
    const type = diff>=2?'elite':'weaver';
    for(let i=0;i<cnt;i++) w5.push({type,x:rnd(40,W-40),y:-100-i*50});
    waves.push(w5);
  }
  // Wave 6: all types
  if(level>=6) {
    const w6=[];
    for(let i=0;i<6;i++) w6.push({type:'basic',x:rnd(40,W-40),y:-100-i*40});
    for(let i=0;i<4;i++) w6.push({type:'kamikaze',x:rnd(40,W-40),y:-300-i*50});
    for(let i=0;i<2;i++) w6.push({type:'elite',x:rnd(60,W-60),y:-500-i*80});
    waves.push(w6);
  }
  return waves;
}

