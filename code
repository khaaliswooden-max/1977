// Inline sfxr-style synth. Renders a sfxr parameter object to a Float32Array
// at the given sample rate. Implements wave shape, ADSR envelope, frequency
// slide, square duty sweep, vibrato, sustain punch, low-pass filter with
// resonance, high-pass filter, and basic repeat (phase reset).
function synthSfxr(p, sampleRate) {
  const SR = sampleRate;
  const waveType   = p.waveType        || 0;
  const attack     = p.attackTime      || 0;
  const sustain    = p.sustainTime     || 0.3;
  const punch      = p.sustainPunch    || 0;
  const decay      = p.decayTime       || 0.4;
  let   freq       = p.startFrequency  || 0.3;
  const minFreq    = p.minFrequency    || 0;
  let   slide      = p.slide           || 0;
  const deltaSlide = p.deltaSlide      || 0;
  const vibDepth   = p.vibratoDepth    || 0;
  const vibSpeed   = p.vibratoSpeed    || 0;
  let   duty       = p.squareDuty      || 0;
  const dutySweep  = p.dutySweep       || 0;
  const repeatSpd  = p.repeatSpeed     || 0;
  const lpCut      = p.lpFilterCutoff  !== undefined ? p.lpFilterCutoff : 1;
  const lpRes      = p.lpFilterResonance || 0;
  const hpCut      = p.hpFilterCutoff  || 0;
  const masterVol  = p.masterVolume    !== undefined ? p.masterVolume : 0.5;

  const attackSamples  = Math.max(1, Math.floor(attack  * SR));
  const sustainSamples = Math.max(1, Math.floor(sustain * SR));
  const decaySamples   = Math.max(1, Math.floor(decay   * SR));
  const totalSamples   = attackSamples + sustainSamples + decaySamples;
  const out = new Float32Array(totalSamples);

  // Low-pass state
  let lpPos = 0, lpVel = 0;
  const lpDamp = 5 * (1 - lpRes);
  // High-pass state
  let hpPos = 0;
  // Oscillator state
  let phase = 0;
  // Frequency mapping: sfxr uses fOsc = 100 / (p*p + 0.001) Hz-ish.
  // Simplified: map p in [0..1] → Hz range approx 30 Hz..8000 Hz via square law.
  function hzOf(p) {
    const pp = Math.max(0.01, Math.min(1, p));
    return 40 + (pp * pp) * 7800;
  }
  // Repeat period in samples (0 = never repeat)
  const repeatSamples = repeatSpd > 0 ? Math.floor((1 - repeatSpd) * 20000) + 1000 : 0;
  let repeatCounter = 0;

  let vibPhase = 0;

  for (let i = 0; i < totalSamples; i++) {
    // Repeat reset
    if (repeatSamples > 0) {
      repeatCounter++;
      if (repeatCounter >= repeatSamples) {
        repeatCounter = 0;
        freq  = p.startFrequency || 0.3;
        slide = p.slide || 0;
        duty  = p.squareDuty || 0;
      }
    }
    // Slide + delta slide
    slide += deltaSlide * 0.00001;
    freq  *= 1 + slide * 0.001;
    if (freq < minFreq) freq = minFreq;
    if (freq > 1) freq = 1;
    // Vibrato
    vibPhase += vibSpeed * 0.06;
    const fVib = freq * (1 + Math.sin(vibPhase) * vibDepth * 0.1);
    // Duty sweep
    duty = Math.max(0, Math.min(0.5, duty + dutySweep * 0.00005));

    // Oscillator
    const hz = hzOf(fVib);
    phase += hz / SR;
    if (phase >= 1) phase -= 1;
    let sample;
    switch (waveType) {
      case 1: sample = 1 - phase * 2; break;                    // saw
      case 2: sample = Math.sin(phase * Math.PI * 2); break;    // sine
      case 3: sample = Math.random() * 2 - 1; break;            // noise
      default: sample = phase < duty + 0.25 ? 0.5 : -0.5;       // square
    }
    // Low-pass filter
    const lpPosOld = lpPos;
    const cutoff = lpCut * lpCut;
    lpVel += (sample - lpPos) * cutoff;
    lpVel -= lpVel * lpDamp * 0.01;
    lpPos += lpVel;
    sample = lpPos;
    // High-pass filter (one-pole)
    hpPos = hpPos * (1 - hpCut * 0.05) + (sample - lpPosOld);
    sample = hpPos;

    // Envelope
    let env;
    if (i < attackSamples) {
      env = i / attackSamples;
    } else if (i < attackSamples + sustainSamples) {
      const s = (i - attackSamples) / sustainSamples;
      env = 1 + punch * (1 - s) * 2;
    } else {
      env = 1 - (i - attackSamples - sustainSamples) / decaySamples;
    }
    out[i] = Math.max(-1, Math.min(1, sample * env * masterVol));
  }
  return out;
}

const Audio = (() => {
  let ctx = null;
  let masterGain, musicGain, sfxGain;
  const buffers = new Map();   // name -> AudioBuffer
  let musicNodes = null;       // active music graph { stop(), setGain() }
  let currentTrack = null;
  let duckTargetGain = 1;
  let duckReleaseAt = 0;

  function ensure() {
    if (ctx) return ctx;
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return null;
    ctx = new AC();
    masterGain = ctx.createGain();
    musicGain  = ctx.createGain();
    sfxGain    = ctx.createGain();
    masterGain.gain.value = Config.get('volMaster');
    musicGain.gain.value  = Config.get('volMusic');
    sfxGain.gain.value    = Config.get('volSfx');
    musicGain.connect(masterGain);
    sfxGain.connect(masterGain);
    masterGain.connect(ctx.destination);
    // Pre-render all SFX buffers now that we have a sample rate.
    for (const [name, params] of Object.entries(SFX_LIBRARY)) {
      const pcm = synthSfxr(params, ctx.sampleRate);
      const buf = ctx.createBuffer(1, pcm.length, ctx.sampleRate);
      buf.copyToChannel(pcm, 0);
      buffers.set(name, buf);
    }
    return ctx;
  }

  function resumeOnGesture() {
    const resume = () => { if (ctx && ctx.state === 'suspended') ctx.resume(); };
    ['pointerdown', 'keydown', 'touchstart'].forEach(ev => {
      window.addEventListener(ev, resume, { once: false, passive: true });
    });
  }

  function play(name) {
    const c = ensure();
    if (!c || Config.get('volMaster') <= 0) return;
    const buf = buffers.get(name);
    if (!buf) return;
    const src = c.createBufferSource();
    src.buffer = buf;
    src.connect(sfxGain);
    src.start();
  }

  // Duck music: drop musicGain to `amount` (0..1) for `ms` then ramp back.
  function duck(amount, ms) {
    const c = ensure();
    if (!c || !musicGain) return;
    const now = c.currentTime;
    const releaseAt = now + ms / 1000;
    duckReleaseAt = releaseAt;
    musicGain.gain.cancelScheduledValues(now);
    musicGain.gain.setValueAtTime(Config.get('volMusic') * amount, now);
    musicGain.gain.linearRampToValueAtTime(Config.get('volMusic'), releaseAt);
  }

  // Apply config volume changes live.
  function applyVolumes() {
    if (!ctx) return;
    masterGain.gain.value = Config.get('volMaster');
    if (!duckReleaseAt || ctx.currentTime > duckReleaseAt) {
      musicGain.gain.value = Config.get('volMusic');
    }
    sfxGain.gain.value = Config.get('volSfx');
  }

  // Simple note-sequence music engine: schedules a loop of pitched pulses.
  // Each track = { bpm, pattern: [[note, len], ...], wave, bass }
  // note: midi-ish number; 0 = rest. len: beats.
  function midiToHz(n) { return 440 * Math.pow(2, (n - 69) / 12); }

  function playMusic(track) {
    if (currentTrack === track && musicNodes) return;
    stopMusic();
    const c = ensure();
    if (!c) return;
    currentTrack = track;
    const { bpm, lead, bass, wave } = track;
    const beat = 60 / bpm;
    const lookahead = 0.1;
    const scheduleAhead = 0.25;
    let leadIdx = 0, bassIdx = 0;
    let leadTime = c.currentTime + 0.05;
    let bassTime = c.currentTime + 0.05;
    let active = true;
    const voices = [];

    function scheduleNote(note, len, startAt, gainNode, waveType, vol) {
      if (!active || note === 0) return;
      const osc = c.createOscillator();
      const g = c.createGain();
      osc.type = waveType;
      osc.frequency.value = midiToHz(note);
      const dur = len * beat;
      const attack = 0.01;
      const release = Math.min(0.08, dur * 0.4);
      g.gain.setValueAtTime(0, startAt);
      g.gain.linearRampToValueAtTime(vol, startAt + attack);
      g.gain.setValueAtTime(vol, startAt + Math.max(attack, dur - release));
      g.gain.linearRampToValueAtTime(0, startAt + dur);
      osc.connect(g); g.connect(gainNode);
      osc.start(startAt);
      osc.stop(startAt + dur + 0.02);
      voices.push(osc);
    }

    const scheduler = setInterval(() => {
      if (!active) return;
      const now = c.currentTime;
      while (leadTime < now + scheduleAhead) {
        const [note, len] = lead[leadIdx % lead.length];
        scheduleNote(note, len, leadTime, musicGain, wave.lead, 0.14);
        leadTime += len * beat;
        leadIdx++;
      }
      while (bassTime < now + scheduleAhead) {
        const [note, len] = bass[bassIdx % bass.length];
        scheduleNote(note, len, bassTime, musicGain, wave.bass, 0.18);
        bassTime += len * beat;
        bassIdx++;
      }
    }, lookahead * 1000);

    musicNodes = {
      stop() {
        active = false;
        clearInterval(scheduler);
        voices.forEach(v => { try { v.stop(); } catch (_) {} });
      }
    };
  }

  function stopMusic() {
    if (musicNodes) { musicNodes.stop(); musicNodes = null; }
    currentTrack = null;
  }

  return { play, duck, playMusic, stopMusic, applyVolumes, resumeOnGesture, ensure };
})();

